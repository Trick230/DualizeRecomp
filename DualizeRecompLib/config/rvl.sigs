# rvl_mtx.c implement.
# <symbol> <size> <masked first word> <masked hash> [at <expression>] [jump]
# (format in DolRecomp's src/app/natives.h; `dolrecomp sign` prints the middle three)

# rvl_os.c: __OSRunQueueHint (small data) and OSDisableInterrupts' mtmsr window.
