# NiGHTS' own code with host hooks in DualizeRecomp/sdk/nights_options.cpp
# (format in DolRecomp's src/app/natives.h). The title module's code, linked
# with the DOL at the address the game loads it to.

# ModeOption (the Options screen): its update.
@ModeOption_Update ADC 9421FE30 9414093684938896

nights_ModeOptionCtor 160 9421FFC0 A6834A5B964A1AB5

# Setting a help line to a message (help, message id): the messages renamed
# first when the game has loaded them again.
@Help_Set 5C 9421FFE0 23E9C7EAAB5A3E3C
nights_HelpSet 4 9421FFE0 D9FC220F5E082681 at @Help_Set jump
# Where the update ends when nothing was chosen.
define NIGHTS_MODE_OPTION_UPDATE_DONE @ModeOption_Update+AC8

# The list's graphics page (sdk/nights_graphics.cpp). A on the "Check Aspect
# Ratio" row, as the update begins its test screen: the list leaves as B
# makes it (its exit animation, then its cancel sound, skipped then) and,
# where the list ends leaving (state 2's end), opens again on the other page.
nights_ModeOptionAspect 4 3C800000 2222E61E074892A9 at @ModeOption_Update+290 jump
define NIGHTS_MODE_OPTION_LEAVE @ModeOption_Update+424
nights_ModeOptionLeaveSound 4 38600002 3820B43C4F2056A7 at @ModeOption_Update+470 jump
define NIGHTS_MODE_OPTION_LEAVE_SOUND_NEXT @ModeOption_Update+47C
nights_ModeOptionLeft 4 38600000 3820B63C4F205A0D at @ModeOption_Update+AB4 jump
# The list's state 1 (r30 the screen), each frame: the call setting its value
# boxes begins it; then the help line (the help object, the call setting a
# message on it), a check that something else has the screen, and the input.
nights_ModeOptionList 4 48000001 4BA5D7D7DCEB1B0A at @ModeOption_Update+138 jump
define NIGHTS_MODE_OPTION_HELP addr(@ModeOption_Update+140,144)
define NIGHTS_MODE_OPTION_ROW_HELP imm(@ModeOption_Update+148)
define NIGHTS_SET_HELP call(@ModeOption_Update+14C)
define NIGHTS_MODE_OPTION_BUSY call(@ModeOption_Update+154)
define NIGHTS_PLAY_SOUND call(@ModeOption_Update+19C)
# A on a row of the main page: the decide sound, then the row's action by the
# screen's row (each of the game's rows opens a window of its own).
define NIGHTS_MODE_OPTION_DECIDE @ModeOption_Update+1A4
# The Rumble row's ON/OFF window (state 5), which the page's own switches
# open too: its opening (the cursor ON for a set switch, from the setting in
# r0: cntlzw hooked), then each frame its help line (lwz r4, row hooked, the
# help the row's plus r4) and, chosen (r31 the settings), the setting written
# by the row (lwz r0, row hooked) from the window's choice (0 ON), before the
# window closes with the decide sound.
define NIGHTS_MODE_OPTION_SWITCH_WINDOW @ModeOption_Update+2EC
nights_ModeOptionSwitchOpen 4 7C000034 CC103C3120B816A5 at @ModeOption_Update+310 jump
nights_ModeOptionSwitchHelp 4 809E00F0 9B5BC0AC997A787B at @ModeOption_Update+80C jump
nights_ModeOptionSwitchChosen 4 801E00F0 469F40AA257CD5FB at @ModeOption_Update+844 jump
define NIGHTS_SWITCH_WINDOW_CHOICE call(@ModeOption_Update+864)
define NIGHTS_MODE_OPTION_SWITCH_CLOSE @ModeOption_Update+8E0
# The value boxes, set from the options, and the rows' highlight with the
# big icon: the graphics page has its own. The calls a screen makes on its CSD
# layout, a node looked up by name in a scene (a handle on the stack), the
# node a handle holds, a cast's pattern, the handle released.
@ModeOption_Values 15C 9421FFC0 5ACC7E18E24014C2
nights_ModeOptionValues 4 9421FFC0 D9FC020F5E07F021 at @ModeOption_Values jump
define CSD_SCENE_NODE call(@ModeOption_Values+28)
define CSD_FIND_NODE call(@ModeOption_Values+38)
define CSD_SET_PATTERN call(@ModeOption_Values+48)
define CSD_RELEASE_HANDLE call(@ModeOption_Values+54)
# The game's settings (the pointer to them): the language at 0xAC (a word),
# rumble at 0xB0 and the weather link at 0xB1 (bytes).
define NIGHTS_SETTINGS addr(@ModeOption_Values+8,24)
@ModeOption_Highlight 138 9421FFC0 2831EA44BA48B21F
nights_ModeOptionHighlight 4 9421FFC0 D9FC020F5E07F021 at @ModeOption_Highlight jump
define NIGHTS_MODE_OPTION_ROW_NODES addr(@ModeOption_Highlight+8,1C)
define NIGHTS_MODE_OPTION_ICON addr(@ModeOption_Highlight+B4,C0)
define NIGHTS_MODE_OPTION_ICON_GLOW addr(@ModeOption_Highlight+F0,FC)
# CSD node methods SetHideFlag(node, hide) forwards to the node's member;
# this is the members' own.
@CsdNode_Method 48 9421FFE0 EA9BE812956F5BFC
define CSD_CAST_SET_HIDE call(@CsdNode_Method+B8)
# A CSD node's property copied from another node's; the colour's SetColor
# (member, const color*): a colour over the one the cast's animation gives.
@CsdNode_CopyProperty 27C 9421FFC0 EB8C9D716205F4E7
define CSD_CAST_SET_COLOR call(@CsdNode_CopyProperty+13C)
# A menu cursor's update: the input manager (a global), its controller, and
# whether buttons (a 64-bit mask) were pressed or, held, repeat.
@MenuCursor 100 9421FFE0 864B1AC517685FAC
define NIGHTS_INPUT addr(@MenuCursor+8,18)
define NIGHTS_INPUT_CONTROLLER call(@MenuCursor+20)
define NIGHTS_INPUT_PRESSED call(@MenuCursor+5C)
define NIGHTS_INPUT_REPEATED call(@MenuCursor+F8)
# The settings list as it opens (its "setting_open" animation just begun):
# the animation starts halfway, past the icons it moves out, and the row's
# icon and highlight are set at once (the list's own call when it ends).
nights_ModeOptionListOpen 4 38610138 2F7AC93C4A3B8283 at @ModeOption_Update+74 jump
define NIGHTS_MODE_OPTION_LIST_OPEN_NEXT @ModeOption_Update+78
define NIGHTS_MODE_OPTION_ROW_ICON call(@ModeOption_Update+C4)

# ModeOption's top level (the Wi-Fi globe and the Wii settings icons): on
# entry the screen goes straight to the settings list instead (the list's
# update, ModeOption_Update, the same frame), and its entrance, reached when
# the list comes back, leaves through its cancel path.
@ModeOption_Top 37C 9421FF80 BDE8AE0A659CE2E2
nights_ModeOptionTopEnter 4 9421FF80 D9FBC20F5E078361 at @ModeOption_Top jump
nights_ModeOptionTop 4 3C800000 2222E61E074892A9 at @ModeOption_Top+44 jump
define NIGHTS_MODE_OPTION_TOP_BODY @ModeOption_Top+4
define NIGHTS_MODE_OPTION_LIST_UPDATE @ModeOption_Update
define NIGHTS_MODE_OPTION_TOP_CANCEL @ModeOption_Top+2A8
# The cancel path, its icons' exit animation just begun in reverse: the list
# has already faded out, so the animation starts at its end, icons hidden.
nights_ModeOptionTopClose 4 38610040 2F777B3C4A38C822 at @ModeOption_Top+2DC jump
define NIGHTS_MODE_OPTION_TOP_CLOSE_NEXT @ModeOption_Top+2E0
# Its cancel sound: B on the list played one already.
nights_ModeOptionTopCancelSound 4 38600002 3820B43C4F2056A7 at @ModeOption_Top+2FC jump
define NIGHTS_MODE_OPTION_TOP_CANCEL_SOUND_NEXT @ModeOption_Top+308
# The top level's help messages (one an icon, from this id): unused offline,
# the graphics page writes its help line into them.
define NIGHTS_MODE_OPTION_TOP_HELP imm(@ModeOption_Top+21C)

# The 2P menu's top update: starting, it waits for the screen fader (the mode
# manager's, which the main menu starts toward black) to reach black.
@Mode2P_Top 328 9421FF80 784EDC1103A6FA6F
nights_Mode2PTop 4 9421FF80 D9FBC20F5E078361 at @Mode2P_Top jump
define NIGHTS_MODE_2P_TOP_BODY @Mode2P_Top+4
define NIGHTS_MODE_MANAGER addr(@Mode2P_Top+14,1C)

# Mode2P (the 2P game menu): its update. Start on the race or battle window
# goes straight to the local game, as Nearby on the opponent list does (the
# list's other two choices are Wi-Fi play); the window then closes as Quit
# closes it (its decide sound and closing animation), since the list's own
# exit animation would show the list.
@Mode2P_Update 764 9421FEB0 8E66B9726776857E
nights_Mode2PStart 4 38600001 3820B53C4F20585A at @Mode2P_Update+254 jump
nights_Mode2PNearby 4 809E0000 9B5C90AC997BD9EB at @Mode2P_Update+44C jump
nights_Mode2PClosing 4 38000003 4D50133CEC202A54 at @Mode2P_Update+324 jump
define NIGHTS_MODE_2P_NEARBY @Mode2P_Update+434
define NIGHTS_MODE_2P_CLOSE @Mode2P_Update+2D8
define NIGHTS_MODE_2P_DONE @Mode2P_Update+74C

# Mode2P's update on the controller screen: B there goes back to the
# opponent list; past its switch back (state 1) the menu reopens the race or
# battle window instead.
@Mode2P_Controllers 64C 9421FEE0 519A8644811B9F43
nights_Mode2PControllersBack 4 809E0000 9B5C90AC997BD9EB at @Mode2P_Controllers+2E8 jump
define NIGHTS_MODE_2P_CONTROLLERS_DONE @Mode2P_Controllers+634

# Mode2P's resume, back from a 2P game: it reopens the opponent list, so it
# opens the race or battle window instead.
@Mode2P_Resume F0 9421FFD0 98D9214CD720959D
nights_Mode2PResume 4 3C800000 2222E61E074892A9 at @Mode2P_Resume+64 jump
define NIGHTS_MODE_2P_RESUME_DONE @Mode2P_Resume+D0

# The Forecast Channel reader My Dream's weather comes from (it reads the
# channel's files off the NAND): its load and the calls the game makes after
# it, answered with the host's current weather instead.
nights_WeatherLoad 27C 9421FF50 4A86FCA2048F7AFB
nights_WeatherForecast 3B8 9421FFD0 97338BC1D012FA4D
nights_WeatherCurrent 238 3CA00000 05248EA8D2856300
nights_WeatherLocation 130 3CA00000 BFE2BD0CF695F255
# Three getters alike but for a field: found by where they sit.
nights_WeatherCity 30 800D0000 11EC9682997C292F at nights_WeatherLoad+86C
nights_WeatherCount 30 800D0000 11EC9682997C292F at nights_WeatherLoad+9CC
nights_WeatherVersion 30 800D0000 11EC9682997C292F at nights_WeatherLoad+9FC
# The reader's "loaded" flag, which its close clears.
define NIGHTS_WEATHER_LOADED_SDA imm(nights_WeatherLoad+18)

# The controller window (the guide shown while playing) is off for good:
# the two places play reads its option read 0, and pass the option on as
# the rumble's switch (its Options row reads Enable Rumble).
@ControllerWindow_Shown DC 9421FFD0 CA155F751274576B
nights_ControllerWindowShown 4 886300B0 F0C599EB84A199CC at @ControllerWindow_Shown+BC jump
define NIGHTS_CONTROLLER_WINDOW_SHOWN_NEXT @ControllerWindow_Shown+C0
@ControllerWindow_Update C4 9421FFF0 407A57003C805DE3
nights_ControllerWindowUpdate 4 880400B0 27AA5EED56B951A1 at @ControllerWindow_Update+1C jump
define NIGHTS_CONTROLLER_WINDOW_UPDATE_NEXT @ControllerWindow_Update+20


# The boot's logo task (main.dol 0x80125EBC). State 1 tests game flag 293
# (cmpwi r3, 0 hooked): set, it plays the Wii Remote strap reminder (state 2),
# whose end asks for the logos and waits for them (state 3); clear, it goes to
# the logos (state 4). The reminder is skipped: set goes straight to its end.
@SegaLogo_Update C5C 9421FD70 8303C7FF8B2DE2F6
nights_StrapReminder 4 2C030000 B3BE349621357818 at @SegaLogo_Update+170 jump
define NIGHTS_STRAP_REMINDER_END @SegaLogo_Update+884
define NIGHTS_STRAP_REMINDER_NONE @SegaLogo_Update+258

# A cutscene's message command (this, ?, command): kind 1 shows a dialogue
# line (a subtitle) through the text messages' EntryMessage, kind 3 takes it
# away. With subtitles off kind 1 does nothing.
@Event_MessageCommand 1B8 9421FFB0 10522D52E79B8741
nights_EventSubtitle 4 2C000001 CDBAA4962FED7266 at @Event_MessageCommand+18 jump
define NIGHTS_EVENT_MESSAGE_COMMAND_DONE @Event_MessageCommand+1A4

# The text's glyphs (sdk/nights_glyph.cpp): a text line's draw, as it draws
# each glyph node; a glyph sprite's draw, right after it has the sprite batch
# add its quad; the text's scale (the pointer the glyph size reads).
@TextLine_Draw 84 9421FFE0 D225E567364FCE2F
nights_GlyphNodeDraw 4 48000001 4BA5D7D7DCEB1B0A at @TextLine_Draw+4C jump
@GlyphNode_Half 94 9421FFD0 E96C74A9867DFDB4
define NIGHTS_GLYPH_SCALE addr(@GlyphNode_Half+14,50)
@GlyphSprite_Draw 140 9421FFB0 CBFFA74A7CD4737A
@SpriteBatch_AddQuad 358 9421FFB0 CC077866A12C4292
define NIGHTS_SPRITE_BATCH_ADD_QUAD @SpriteBatch_AddQuad
nights_GlyphQuad 4 2C030000 B3BE349621357818 at @GlyphSprite_Draw+FC jump
