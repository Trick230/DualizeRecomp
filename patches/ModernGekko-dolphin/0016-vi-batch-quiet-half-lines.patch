+// Whether Update() at this half-line count does more than advance the beam.
+bool VideoInterfaceManager::HalfLineHasEffect(u32 half_line) const
+{
+  if (half_line == 0 || half_line == GetHalfLinesPerOddField() ||
+      half_line == m_odd_field_first_hl || half_line == m_even_field_first_hl ||
+      half_line == m_odd_field_last_hl || half_line == m_even_field_last_hl ||
+      half_line == m_half_line_of_next_si_poll)
+  {
+    return true;
+  }
+  u32 next = half_line + 1;
+  if (next == GetHalfLinesPerEvenField() + GetHalfLinesPerOddField())
+    next = 0;
+  for (const UVIInterruptRegister& reg : m_interrupt_register)
+  {
+    const u32 target_halfline = (reg.HCT > m_h_timing_0.HLW) ? 1 : 0;
+    if (1 + next / 2 == reg.VCT && (next & 1) == target_halfline)
+      return true;
+  }
+  return false;
+}
+
+u32 VideoInterfaceManager::QuietHalfLinesAhead() const
+{
+  const u32 total = GetHalfLinesPerEvenField() + GetHalfLinesPerOddField();
+  u32 half_line = m_half_line_count;
+  u32 quiet = 0;
+  while (quiet < total && !HalfLineHasEffect(half_line))
+  {
+    ++quiet;
+    half_line = half_line + 1 == total ? 0 : half_line + 1;
+  }
+  return quiet < total ? quiet : 0;
+}
+
+// What Update() does at a half-line without effects.
+void VideoInterfaceManager::ApplyQuietHalfLine(u64 ticks)
+{
+  ++m_half_line_count;
+  if (m_half_line_count == GetHalfLinesPerEvenField() + GetHalfLinesPerOddField())
+    m_half_line_count = 0;
+  if (!(m_half_line_count & 1))
+    m_ticks_last_line_start = ticks;
+}
+
+void VideoInterfaceManager::CatchUpQuietHalfLines(u64 ticks)
+{
+  while (m_quiet_half_lines != 0 && ticks >= m_last_update_ticks + m_batch_ticks_per_half_line)
+  {
+    m_last_update_ticks += m_batch_ticks_per_half_line;
+    --m_quiet_half_lines;
+    ApplyQuietHalfLine(m_last_update_ticks);
+  }
+}
+
+s64 VideoInterfaceManager::RunScheduledUpdate(u64 ticks)
+{
+  while (m_quiet_half_lines != 0)
+  {
+    m_last_update_ticks += m_batch_ticks_per_half_line;
+    --m_quiet_half_lines;
+    ApplyQuietHalfLine(m_last_update_ticks);
+  }
+  Update(ticks);
+  m_last_update_ticks = ticks;
+  m_batch_ticks_per_half_line = GetTicksPerHalfLine();
+  m_quiet_half_lines = m_batch_ticks_per_half_line != 0 ? QuietHalfLinesAhead() : 0;
+  return static_cast<s64>(m_quiet_half_lines + 1) * m_batch_ticks_per_half_line;
+}
+
+void VideoInterfaceManager::BeginTimingChange()
+{
+  CatchUpQuietHalfLines(m_system.GetCoreTiming().GetTicks());
+}
+
+void VideoInterfaceManager::EndTimingChange()
+{
+  // With nothing batched the VI event is already at the next half-line, which re-plans.
+  if (m_quiet_half_lines == 0)
+    return;
+  const u32 ticks_per_half_line = GetTicksPerHalfLine();
+  if (ticks_per_half_line == 0)
+    return;
+  // The next half-line stays where it was due; the new length applies from there on.
+  m_last_update_ticks += m_batch_ticks_per_half_line;
+  m_last_update_ticks -= ticks_per_half_line;
+  m_batch_ticks_per_half_line = ticks_per_half_line;
+  m_quiet_half_lines = QuietHalfLinesAhead();
+  auto& core_timing = m_system.GetCoreTiming();
+  const s64 due = static_cast<s64>(m_last_update_ticks +
+                                   u64{m_quiet_half_lines + 1} * ticks_per_half_line);
+  auto* const event_type = m_system.GetSystemTimers().GetVIEventType();
+  core_timing.RemoveEvent(event_type);
+  core_timing.ScheduleEvent(std::max<s64>(due - static_cast<s64>(core_timing.GetTicks()), 0),
+                            event_type);
+}
+
+void VideoInterfaceManager::PrepareForSave()
+{
+  if (m_quiet_half_lines == 0)
+    return;
+  auto& core_timing = m_system.GetCoreTiming();
+  CatchUpQuietHalfLines(core_timing.GetTicks());
+  if (m_quiet_half_lines == 0)
+    return;
+  m_quiet_half_lines = 0;
+  core_timing.MoveEventWhilePaused(
+      m_system.GetSystemTimers().GetVIEventType(),
+      static_cast<s64>(m_last_update_ticks + m_batch_ticks_per_half_line));
+}
