+// Devices the host serves itself under the names of devices in the map. The
+// map keeps Dolphin's devices for the code that reaches them directly; the
+// game's IPC goes to the native ones.
+struct NativeDevices
+{
+  // Adds the host's devices to a new kernel (EmulationKernel::AddNativeDevice).
+  void (*create)(EmulationKernel& kernel);
+  // An EmulationKernel::ScheduleNativeEvent event.
+  void (*event)(EmulationKernel& kernel, u64 userdata);
+  // DVDInterface finished a /dev/di command: true if a native /dev/di took it.
+  bool (*di_interrupt)(EmulationKernel& kernel, bool success);
+  // A console button press: true if a native /dev/stm/eventhook took it.
+  bool (*stm_button)(EmulationKernel& kernel, bool power);
+};
+void SetNativeDevices(const NativeDevices* devices);
+const NativeDevices* GetNativeDevices();
+
