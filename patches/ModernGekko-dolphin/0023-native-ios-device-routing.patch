+void EmulationKernel::AddNativeDevice(std::shared_ptr<Device> device)
+{
+  ASSERT(m_device_map.contains(device->GetDeviceName()));
+  m_native_device_map[device->GetDeviceName()] = std::move(device);
+}
+
+std::shared_ptr<Device> EmulationKernel::GetNativeDevice(std::string_view device_name)
+{
+  const auto iterator = m_native_device_map.find(device_name);
+  return iterator != m_native_device_map.end() ? iterator->second : nullptr;
+}
+
+void EmulationKernel::ScheduleNativeEvent(s64 cycles, u64 userdata)
