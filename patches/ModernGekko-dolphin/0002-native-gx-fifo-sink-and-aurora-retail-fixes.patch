+{
+  // The sink decodes GX commands itself, so the emulated GPU state saved
+  // elsewhere never saw them.
+  std::vector<u8> state;
+  if (!p.IsReadMode() && m_burst_state)
+    m_burst_state(&state, false, m_burst_sink_user);
+  p.Do(state);
+  if (p.IsReadMode() && m_burst_state)
+    m_burst_state(&state, true, m_burst_sink_user);
