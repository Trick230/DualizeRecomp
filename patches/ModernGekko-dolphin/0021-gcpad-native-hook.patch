@@ -31,4 +31,17 @@ void Rumble(int pad_num, ControlState strength);
 void ResetRumble(int pad_num);
 
 bool GetMicButton(int pad_num);
+
+// A host-side source that replaces InputCommon for the emulated pads.
+struct NativeHooks
+{
+  void* user;
+  // False leaves this pad on InputCommon.
+  bool (*read)(void* user, int pad_num, GCPadStatus* status);
+  void (*rumble)(void* user, int pad_num, ControlState strength);
+};
+
+// nullptr restores InputCommon.
+void SetNative(const NativeHooks* hooks);
+const NativeHooks* GetNative();
 }  // namespace Pad
