+// Optional: the same flags per line of MEM1 for calls whose target is only
+// known at run time. A table of another line size would be misread, so it then
+// leaves those calls on the chassis.
+extern const unsigned char* dolrecomp_direct_lines;
+extern u32 dolrecomp_direct_lines_size;
+
+RECOMP_MODULE_EXPORT void staticrecomp_set_direct_lines(const unsigned char* lines, u32 size,
+                                                        u32 line_shift)
+{
+    const int usable = lines && line_shift == DOLRECOMP_DIRECT_LINE_SHIFT;
+    dolrecomp_direct_lines = usable ? lines : NULL;
+    dolrecomp_direct_lines_size = usable ? size : 0u;
+}
