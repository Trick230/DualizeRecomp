+void StaticRecompCore::MarkDirectLines(u32 index)
+{
+  const StaticRecompRange& chunk = m_module->chunk_ranges[index];
+  if (chunk.start < 0x80000000u)
+    return;
+  constexpr u32 line_size = 1u << DIRECT_LINE_SHIFT;
+  const u32 first = (chunk.start - 0x80000000u + line_size - 1) >> DIRECT_LINE_SHIFT;
+  const u32 last = std::min<u32>((chunk.end - 0x80000000u) >> DIRECT_LINE_SHIFT,
+                                 static_cast<u32>(m_direct_lines.size()));
+  for (u32 line = first; line < last; ++line)
+    m_direct_lines[line] = m_direct_call_ok[index];
 }
 
