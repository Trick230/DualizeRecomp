diff --git a/Source/Core/Core/HW/WiimoteEmu/NativeInput.h b/Source/Core/Core/HW/WiimoteEmu/NativeInput.h
new file mode 100644
index 0000000..7153127
--- /dev/null
+++ b/Source/Core/Core/HW/WiimoteEmu/NativeInput.h
@@ -0,0 +1,37 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include "Common/CommonTypes.h"
+
+// A host-side input source that replaces InputCommon for the buttons, sticks
+// and triggers of emulated Wii Remotes and their Classic Controllers. Motion
+// and IR keep Dolphin's emulation.
+namespace WiimoteEmu
+{
+struct NativeInput
+{
+  // In: a Classic Controller is attached, so the classic fields are used.
+  bool classic = false;
+  // Wii Remote button bits (WiimoteCommon::ButtonData).
+  u16 buttons = 0;
+  // Classic Controller button bits (Classic::BUTTON_* / PAD_* / TRIGGER_*).
+  u16 classic_buttons = 0;
+  // Sticks in [-1, 1], up and right positive; triggers in [0, 1].
+  float left_x = 0, left_y = 0, right_x = 0, right_y = 0;
+  float left_trigger = 0, right_trigger = 0;
+};
+
+struct NativeInputHooks
+{
+  void* user;
+  // False leaves this remote on InputCommon.
+  bool (*read)(void* user, int index, NativeInput* input);
+  void (*rumble)(void* user, int index, bool on);
+};
+
+// nullptr restores InputCommon.
+void SetNativeInput(const NativeInputHooks* hooks);
+const NativeInputHooks* GetNativeInput();
+}  // namespace WiimoteEmu
