+void Classic::BuildNativeExtensionState(const NativeInput& input,
+                                        DesiredExtensionState* target_state)
+{
+  using ControllerEmu::MapFloat;
+
+  DataFormat classic_data = {};
+  classic_data.SetLeftStick({MapFloat<u8>(input.left_x, LEFT_STICK_CENTER, 0, LEFT_STICK_RANGE),
+                             MapFloat<u8>(input.left_y, LEFT_STICK_CENTER, 0, LEFT_STICK_RANGE)});
+  classic_data.SetRightStick(
+      {MapFloat<u8>(input.right_x, RIGHT_STICK_CENTER, 0, RIGHT_STICK_RANGE),
+       MapFloat<u8>(input.right_y, RIGHT_STICK_CENTER, 0, RIGHT_STICK_RANGE)});
+  classic_data.SetLeftTrigger(MapFloat<u8>(input.left_trigger, 0, 0, TRIGGER_RANGE));
+  classic_data.SetRightTrigger(MapFloat<u8>(input.right_trigger, 0, 0, TRIGGER_RANGE));
+  classic_data.SetButtons(input.classic_buttons);
+
+  target_state->data = classic_data;
+}
+
 void Classic::Update(const DesiredExtensionState& target_state)
 {
   DefaultExtensionUpdate<DataFormat>(&m_reg, target_state);
