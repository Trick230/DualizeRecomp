+// Native DSP: a host module that owns the DSP interface registers, the DSP
+// and the audio DMA. While one is installed this manager only routes MMIO, its
+// events, time slices and savestates to it.
+struct NativeDSP
+{
+  void* user;
+  // Called from Init, once memory is up, and from Shutdown.
+  void (*start)(void* user);
+  void (*stop)(void* user);
+  u16 (*read)(void* user, u32 offset);  // offset within the block, e.g. 0x500A
+  void (*write)(void* user, u32 offset, u16 value);
+  void (*interrupt)(void* user, u32 type);  // a ScheduleNativeInterrupt came due
+  void (*aram_done)(void* user);            // a ScheduleNativeARAMDone came due
+  void (*update)(void* user);               // the DSP's time slice
+  void (*audio_dma)(void* user);            // one 32-byte audio DMA step
+  void (*do_state)(void* user, PointerWrap& p);
+};
