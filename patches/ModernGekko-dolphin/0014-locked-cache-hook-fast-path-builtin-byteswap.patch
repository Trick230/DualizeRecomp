+// The locked cache bytes an access within one page maps to, or null. Once the
+// effective address translates into the L1 window the MMU would only copy
+// big-endian bytes to or from it, which the hooks below then do directly.
+u8* StaticRecompCore::LockedCacheBytes(u32 ea, u32 size)
+{
+  if ((ea >> 28) != (LOCKED_CACHE_BASE >> 28) || ((ea ^ (ea + size - 1)) & ~(HW_PAGE_SIZE - 1)))
+    return nullptr;
+  auto& memory = m_system.GetMemory();
+  if (!memory.GetL1Cache())
+    return nullptr;
+  PropagateGuestMSR();
+  const std::optional<u32> physical = m_system.GetMMU().GetTranslatedAddress(ea);
+  if (!physical || (*physical >> 28) != (LOCKED_CACHE_BASE >> 28) ||
+      (*physical & 0x0FFFFFFFu) + size > memory.GetL1CacheSize())
+  {
+    return nullptr;
+  }
+  return memory.GetL1Cache() + (*physical & 0x0FFFFFFFu);
+}
