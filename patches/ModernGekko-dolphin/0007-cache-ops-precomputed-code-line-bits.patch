@@ -216,6 +216,10 @@ private:
 
   // Lookup table optimization for O(1) chunk searches
   std::vector<int> m_chunk_lookup_table;
+  // One bit per 32-byte line of the lookup index space: set when the line
+  // overlaps a DOL chunk. REL chunks move with their module and are checked
+  // against m_active_rel_sections instead.
+  std::vector<u64> m_dol_code_lines;
   u32 m_lookup_ram_size = 0;
   u32 m_lookup_exram_size = 0;
   int GetAddressLookupIndex(u32 address) const;
diff --git a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Hooks.cpp b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Hooks.cpp
index e11b875..028afc5 100644
--- a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Hooks.cpp
+++ b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Hooks.cpp
@@ -370,9 +370,23 @@ void StaticRecompCore::HookCacheControl(CPUState* cpu, u8 operation, u32 ea, u32
 // Jit64::dcbx tests the block cache's valid_block bits before calling out.
 bool StaticRecompCore::LineMayHoldCode(u32 ea)
 {
+  // Runs once per flushed line, so it must stay cheap: no chunk resolution
+  // (whose miss path rescans RAM for REL headers), only the precomputed DOL
+  // line bits and the few loaded REL sections.
   const u32 line = ea & ~31u;
-  if (ChunkIndexOf(line) >= 0 || ChunkIndexOf(line + 28) >= 0)
-    return true;
+  if (m_module_active)
+  {
+    const int idx = GetAddressLookupIndex(line);
+    if (idx >= 0 && static_cast<size_t>(idx >> 9) < m_dol_code_lines.size() &&
+        ((m_dol_code_lines[idx >> 9] >> ((idx >> 3) & 63)) & 1u) != 0)
+      return true;
+    for (const ActiveRelSection& section : m_active_rel_sections)
+    {
+      if (line + 32u > section.runtime_start &&
+          static_cast<u64>(line) < static_cast<u64>(section.runtime_start) + section.size)
+        return true;
+    }
+  }
   if (!m_fallback_jit)
     return false;
 
