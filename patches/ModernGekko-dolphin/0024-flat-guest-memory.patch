diff --git a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Run.cpp b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Run.cpp
index 103efd6..64104f4 100644
--- a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Run.cpp
+++ b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Run.cpp
@@ -7,7 +7,10 @@
 #include "Core/PowerPC/Interpreter/Interpreter.h"
 #include "Core/PowerPC/StaticRecomp/StaticRecompLockstep.h"
 #include "Core/CoreTiming.h"
+#include "Common/MsgHandler.h"
 #include "Core/HW/CPU.h"
+#include "Core/HW/Memmap.h"
+#include "Core/PowerPC/MMU.h"
 #include "Core/Config/MainSettings.h"
 #include "Core/Config/ConfigManager.h"
 #include "Core/HW/SystemTimers.h"
@@ -66,6 +69,20 @@ void StaticRecompCore::Run()
   const bool lockstep_enabled = m_lockstep_verifier->IsEnabled();
   // Lockstep journals every RAM store, so it keeps stores off the fast tables.
   ppc_build_fast_memory(&m_guest, !lockstep_enabled);
+  // Modules reach guest memory at flat_base + ea: Dolphin's fastmem view of
+  // the BAT-mapped address space, MMIO left unmapped. The view only follows
+  // BAT updates once the arena exists, so remap the current BATs into it.
+  // (Lockstep cannot see these stores.)
+  if (!m_guest.flat_base && memory.InitFastmemArena())
+  {
+    m_system.GetMMU().DBATUpdated();
+    m_guest.flat_base = memory.GetLogicalBase();
+  }
+  if (!m_guest.flat_base)
+  {
+    PanicAlertFmt("Static recompiler: no fastmem arena for the module's guest memory");
+    return;
+  }
   // Gather-pipe stores short of a burst append straight to GPFifo's buffer;
   // lockstep journals every one of them through HookExternalWrite instead.
   m_guest.gather_pipe_ptr = lockstep_enabled ? nullptr : &ppc.gather_pipe_ptr;
