+// With the data cache off, dcbst/dcbf/dcbi only matter to the code caches: each
+// invalidates one icache line. Nearly every call flushes plain data
+// (DCFlushRange over vertex and texture buffers), so lines that hold neither
+// module code nor a fallback JIT block skip the invalidation, exactly as
+// Jit64::dcbx tests the block cache's valid_block bits before calling out.
+bool StaticRecompCore::LineMayHoldCode(u32 ea)
+{
+  const u32 line = ea & ~31u;
+  if (ChunkIndexOf(line) >= 0 || ChunkIndexOf(line + 28) >= 0)
+    return true;
+  if (!m_fallback_jit)
+    return false;
+
+  u32 physical = line;
+  if (m_guest.msr & PPC_MSR_IR)
+  {
+    const u32 bat = m_system.GetMMU().GetIBATTable()[line >> PowerPC::BAT_INDEX_SHIFT];
+    // Page-table translation: leave it to the full invalidation path.
+    if ((bat & PowerPC::BAT_MAPPED_BIT) == 0)
+      return true;
+    physical = (bat & PowerPC::BAT_RESULT_MASK) | (line & (PowerPC::BAT_PAGE_SIZE - 1));
+  }
+  const u32* valid_block = m_fallback_jit->GetBlockCache()->GetBlockBitSet();
+  return ((valid_block[physical >> 10] >> ((physical >> 5) & 31u)) & 1u) != 0;
+}
