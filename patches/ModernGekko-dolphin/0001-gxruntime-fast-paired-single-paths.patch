+/* ps_add: with all four inputs finite, ni_add raises no FPSCR exception and
+ * does not touch FI/FR, so the sum is a plain host add. NaN/inf inputs take
+ * the full interpreter-accurate path. */
+#if defined(_MSC_VER)
+#define GXRUNTIME_PS_INLINE static __forceinline
+#else
+#define GXRUNTIME_PS_INLINE static inline __attribute__((always_inline))
+#endif
+GXRUNTIME_PS_INLINE void ppc_ps_add_op(CPUState* cpu, u8 d, u8 a, u8 b) {
+    const f64 a0 = cpu->fpr[a], b0 = cpu->fpr[b], a1 = cpu->ps1[a], b1 = cpu->ps1[b];
+    u64 ba0, bb0, ba1, bb1;
+    memcpy(&ba0, &a0, 8); memcpy(&bb0, &b0, 8); memcpy(&ba1, &a1, 8); memcpy(&bb1, &b1, 8);
+    const u64 exp_mask = 0x7FF0000000000000ull;
+    if ((ba0 & exp_mask) == exp_mask || (bb0 & exp_mask) == exp_mask ||
+        (ba1 & exp_mask) == exp_mask || (bb1 & exp_mask) == exp_mask) {
+        ppc_ps_add_op_slow(cpu, d, a, b);
+        return;
+    }
+    f64 sums[2] = {a0 + b0, a1 + b1};
+    f32 out[2];
+    for (int lane = 0; lane < 2; ++lane) {
+        u64 bits;
+        memcpy(&bits, &sums[lane], 8);
+        /* force_single: with FPSCR[NI], values below the f32 normal range
+         * flush to signed zero. */
+        if ((cpu->fpscr & 0x4u) && (bits & 0x7FFFFFFFFFFFFFFFull) < 0x3810000000000000ull) {
+            const u32 flushed = (u32)((bits & 0x8000000000000000ull) >> 32);
+            memcpy(&out[lane], &flushed, 4);
+        } else {
+            out[lane] = (f32)sums[lane];
+        }
+    }
+    cpu->fpr[d] = (f64)out[0];
+    cpu->ps1[d] = (f64)out[1];
+    /* set_fprf(classify_f32(ps0)) */
+    u32 r;
+    memcpy(&r, &out[0], 4);
+    const u32 sign = r >> 31, exponent = r & 0x7F800000u, fraction = r & 0x007FFFFFu;
+    const u32 fprf = exponent == 0x7F800000u ? (fraction ? 0x11u : (sign ? 0x09u : 0x05u))
+                   : exponent == 0u ? (fraction ? (sign ? 0x18u : 0x14u) : (sign ? 0x12u : 0x02u))
+                   : (sign ? 0x08u : 0x04u);
+    cpu->fpscr = (cpu->fpscr & ~(0x1Fu << 12)) | (fprf << 12);
+}
