+// Every file the module build compiles from the source tree, by relative path
+// and content hash. Small enough (a few hundred KiB) to hash on each build.
+std::string ModuleSourcesIdentity(const fs::path& source_root)
+{
+  std::vector<std::pair<std::string, fs::path>> files;
+  for (const char* dir : {"vendor/dolphin/module-template", "vendor/dolphin/GXRuntime/include",
+                          "vendor/dolphin/GXRuntime/src/core"})
+  {
+    std::error_code ec;
+    for (fs::recursive_directory_iterator it(source_root / dir, ec), end; !ec && it != end;
+         it.increment(ec))
+    {
+      if (it->is_regular_file(ec))
+        files.emplace_back(it->path().lexically_relative(source_root).generic_string(), it->path());
+    }
+  }
+  std::ranges::sort(files);
+  std::string identity;
+  for (const auto& [relative, path] : files)
+    identity += relative + "=" + moderngekko::HashFileSha256(path).value_or("unreadable") + ";";
+  std::ostringstream digest;
+  digest << std::hex << std::setfill('0') << std::setw(16) << Fnv1a(identity);
+  return digest.str();
+}
