+// Guest register state saved around an automation call.
+struct SavedGuestRegisters
+{
+  u32 pc, npc, msr, fpscr, exceptions, reserve_address;
+  int downcount;
+  u8 xer_ca, xer_so_ov;
+  u16 xer_stringctrl;
+  bool reserve;
+  PowerPC::ConditionRegister cr;
+  std::array<u32, 32> gpr;
+  std::array<PowerPC::PairedSingle, 32> ps;
+  std::array<u32, 1024> spr;
+
+  explicit SavedGuestRegisters(const PowerPC::PowerPCState& ppc)
+      : pc(ppc.pc), npc(ppc.npc), msr(ppc.msr.Hex), fpscr(ppc.fpscr.Hex),
+        exceptions(ppc.Exceptions), reserve_address(ppc.reserve_address),
+        downcount(ppc.downcount), xer_ca(ppc.xer_ca), xer_so_ov(ppc.xer_so_ov),
+        xer_stringctrl(ppc.xer_stringctrl), reserve(ppc.reserve), cr(ppc.cr),
+        spr(std::to_array(ppc.spr))
+  {
+    std::copy_n(ppc.gpr, 32, gpr.begin());
+    std::copy_n(ppc.ps, 32, ps.begin());
+  }
+
+  void Restore(PowerPC::PowerPCState& ppc) const
+  {
+    ppc.pc = pc;
+    ppc.npc = npc;
+    ppc.msr.Hex = msr;
+    ppc.fpscr.Hex = fpscr;
+    ppc.Exceptions = exceptions;
+    ppc.reserve_address = reserve_address;
+    ppc.downcount = downcount;
+    ppc.xer_ca = xer_ca;
+    ppc.xer_so_ov = xer_so_ov;
+    ppc.xer_stringctrl = xer_stringctrl;
+    ppc.reserve = reserve;
+    ppc.cr = cr;
+    std::ranges::copy(gpr, ppc.gpr);
+    std::ranges::copy(ps, ppc.ps);
+    std::ranges::copy(spr, ppc.spr);
+  }
+
+  // Only what an OSContext holds: time (TB, DEC), pending exceptions and the
+  // rest of the machine moved on while the thread ran.
+  void RestoreThreadContext(PowerPC::PowerPCState& ppc) const
+  {
+    ppc.pc = pc;
+    ppc.npc = npc;
+    ppc.msr.Hex = msr;
+    ppc.fpscr.Hex = fpscr;
+    ppc.xer_ca = xer_ca;
+    ppc.xer_so_ov = xer_so_ov;
+    ppc.xer_stringctrl = xer_stringctrl;
+    ppc.reserve = false;
+    ppc.cr = cr;
+    std::ranges::copy(gpr, ppc.gpr);
+    std::ranges::copy(ps, ppc.ps);
+    for (const u32 index : {u32{SPR_LR}, u32{SPR_CTR}, u32{SPR_GQR0}, u32{SPR_GQR0} + 1,
+                            u32{SPR_GQR0} + 2, u32{SPR_GQR0} + 3, u32{SPR_GQR0} + 4,
+                            u32{SPR_GQR0} + 5, u32{SPR_GQR0} + 6, u32{SPR_GQR0} + 7})
+    {
+      ppc.spr[index] = spr[index];
+    }
+  }
+};
+
+constexpr u32 kCurrentThreadAddress = 0x800000E4u;
+
+// Pauses the CPU at a dispatch boundary where `thread` (an OSThread, 0 for
+// any) is current and, if `need_ee`, external interrupts are enabled.
+std::optional<RuntimeError> PauseOnGuestThread(std::optional<Core::CPUThreadGuard>& guard,
+                                               u32 thread, bool need_ee)
+{
+  constexpr int max_attempts = 2000;
+  auto& system = Core::System::GetInstance();
+  for (int attempt = 0;; ++attempt)
+  {
+    guard.emplace(system);
+    const u32 current = system.GetMemory().Read_U32(kCurrentThreadAddress);
+    if ((thread == 0 || current == thread) && (!need_ee || system.GetPPCState().msr.EE))
+      return {};
+    guard.reset();
+    if (attempt == max_attempts)
+    {
+      return RuntimeError{RuntimeErrorCode::InvalidState,
+                          fmt::format("guest thread {:#010x} never became current", thread)};
+    }
+    // Long enough for the CPU to actually run before the next look.
+    std::this_thread::sleep_for(std::chrono::milliseconds(2));
+  }
+}
+
+std::optional<RuntimeError> WriteCallResult(const std::filesystem::path& path, u32 r3, double f1)
+{
+  if (path.empty())
+    return {};
+  std::error_code ec;
+  std::filesystem::create_directories(path.parent_path(), ec);
+  std::ofstream output(path, std::ios::trunc);
+  output << fmt::format("r3={:#010x}\nf1={}\n", r3, f1);
+  if (!output)
+    return RuntimeError{RuntimeErrorCode::InitializationFailed, "could not write call result"};
+  return {};
+}
+
+// Runs one guest function to completion with the CPU paused, on the
+// interpreter, then puts every register back so the paused guest resumes as if
+// nothing happened; only the callee's memory side effects remain. The return
+// address is the low-memory header at 0x80000000, which is never code.
+//
+// A callee that blocks (a contended OSLockMutex) would switch guest threads
+// under us, so the call only starts while `thread` is current (or, for
+// thread 0, while interrupts are enabled, i.e. outside an OS critical
+// section), and fails instead of resuming another thread if the current
+// thread changes. Callees that wait on hardware (DVD, VI) need the async form.
+std::optional<RuntimeError> CallGuestFunctionPaused(const std::filesystem::path& path,
+                                                    u32 address,
+                                                    const std::vector<std::uint32_t>& args,
+                                                    u32 thread)
+{
+  constexpr u32 return_address = 0x80000000u;
+  constexpr u64 max_steps = 200'000'000;
+  auto& system = Core::System::GetInstance();
+  auto& memory = system.GetMemory();
+  std::optional<Core::CPUThreadGuard> guard;
+  if (auto error = PauseOnGuestThread(guard, thread, thread == 0))
+    return error;
+  const u32 caller_thread = memory.Read_U32(kCurrentThreadAddress);
+  auto& ppc = system.GetPPCState();
+  auto& interpreter = system.GetInterpreter();
+  const SavedGuestRegisters saved(ppc);
+
+  for (std::size_t i = 0; i < args.size(); ++i)
+    ppc.gpr[3 + i] = args[i];
+  ppc.msr.EE = 0;
+  ppc.Exceptions = 0;
+  ppc.reserve = false;
+  LR(ppc) = return_address;
+  ppc.pc = ppc.npc = address;
+  u64 steps = 0;
+  bool switched = false;
+  while (ppc.pc != return_address && steps++ < max_steps &&
+         !(switched = memory.Read_U32(kCurrentThreadAddress) != caller_thread))
+  {
+    interpreter.SingleStepInner();
+  }
+  const bool returned = ppc.pc == return_address;
+  const u32 r3 = ppc.gpr[3];
+  const double f1 = ppc.ps[1].PS0AsDouble();
+  saved.Restore(ppc);
+
+  if (switched)
+  {
+    return RuntimeError{RuntimeErrorCode::InvalidState,
+                        fmt::format("guest call {:#010x} blocked and switched threads; guest "
+                                    "state is no longer consistent",
+                                    address)};
+  }
+  if (!returned)
+  {
+    return RuntimeError{RuntimeErrorCode::InvalidState,
+                        fmt::format("guest call {:#010x} did not return within {} steps",
+                                    address, max_steps)};
+  }
+  return WriteCallResult(path, r3, f1);
+}
+
+// Runs one guest function on `thread` while the game keeps running, so the
+// callee may block, take interrupts and wait on hardware like any guest code.
+// The thread is diverted, at a point where interrupts are enabled, into a
+// trampoline in the unused low-memory area at 0x80001900 that calls the
+// function, publishes r3/f1 and a done flag, then spins in place; once the
+// thread is back on the spin, every register is put back as it was.
+std::optional<RuntimeError> CallGuestFunctionAsync(const std::filesystem::path& path,
+                                                   u32 address,
+                                                   const std::vector<std::uint32_t>& args,
+                                                   u32 thread)
+{
+  constexpr u32 trampoline = 0x80001900u;
+  constexpr u32 data = 0x80001980u;  // function, r3, f1 (8 bytes), done
+  constexpr std::array<u32, 10> code = {
+      0x3D808000u,  // lis   r12, 0x8000
+      0x818C1980u,  // lwz   r12, 0x1980(r12)
+      0x7D8903A6u,  // mtctr r12
+      0x4E800421u,  // bctrl
+      0x3D808000u,  // lis   r12, 0x8000
+      0x906C1984u,  // stw   r3, 0x1984(r12)
+      0xD82C1988u,  // stfd  f1, 0x1988(r12)
+      0x38000001u,  // li    r0, 1
+      0x900C1990u,  // stw   r0, 0x1990(r12)
+      0x48000000u,  // b     .
+  };
+  constexpr u32 spin = trampoline + 4 * (code.size() - 1);
+  constexpr auto timeout = std::chrono::minutes(2);
+
+  auto& system = Core::System::GetInstance();
+  auto& memory = system.GetMemory();
+  std::optional<Core::CPUThreadGuard> guard;
+  if (auto error = PauseOnGuestThread(guard, thread, true))
+    return error;
+  const u32 caller_thread = memory.Read_U32(kCurrentThreadAddress);
+  auto& ppc = system.GetPPCState();
+  const SavedGuestRegisters saved(ppc);
+  for (std::size_t i = 0; i < code.size(); ++i)
+    memory.Write_U32(code[i], trampoline + 4 * static_cast<u32>(i));
+  memory.Write_U32(address, data);
+  memory.Write_U32(0, data + 16);
+  for (std::size_t i = 0; i < args.size(); ++i)
+    ppc.gpr[3 + i] = args[i];
+  ppc.pc = ppc.npc = trampoline;
+  guard.reset();
+
+  const auto deadline = std::chrono::steady_clock::now() + timeout;
+  while (std::chrono::steady_clock::now() < deadline)
+  {
+    std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    guard.emplace(system);
+    if (memory.Read_U32(data + 16) != 0 &&
+        memory.Read_U32(kCurrentThreadAddress) == caller_thread && ppc.pc == spin)
+    {
+      const u32 r3 = memory.Read_U32(data + 4);
+      const double f1 = std::bit_cast<double>(memory.Read_U64(data + 8));
+      saved.RestoreThreadContext(ppc);
+      return WriteCallResult(path, r3, f1);
+    }
+    guard.reset();
+  }
+  const Core::CPUThreadGuard final_guard(system);
+  return RuntimeError{RuntimeErrorCode::InvalidState,
+                      fmt::format("async guest call {:#010x} did not return (done={}, thread "
+                                  "{:#010x}, pc {:#010x}); the thread is still diverted",
+                                  address, memory.Read_U32(data + 16),
+                                  memory.Read_U32(kCurrentThreadAddress), ppc.pc)};
+}
