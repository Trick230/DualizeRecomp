+// call address=<guest function> [args=<r3>,<r4>,...] [thread=<OSThread>] [async=0|1]
+//      [path=<result file>]
+bool ParseCallCommand(const std::map<std::string, std::string>& values, Command* command,
+                      std::string* error)
+{
+  constexpr std::size_t max_args = 8;  // r3..r10
+  for (const auto& [key, value] : values)
+  {
+    if (key != "command" && key != "address" && key != "args" && key != "thread" &&
+        key != "async" && key != "path")
+    {
+      if (error)
+        *error = "unknown call field: " + key;
+      return false;
+    }
+  }
+
+  const auto address_it = values.find("address");
+  const auto address =
+      address_it == values.end() ? std::nullopt : ParseUnsigned(address_it->second);
+  if (!address || (*address & 3) != 0)
+  {
+    if (error)
+      *error = "call requires address=<word-aligned guest function>";
+    return false;
+  }
+
+  if (const auto args_it = values.find("args"); args_it != values.end())
+  {
+    std::string_view rest = args_it->second;
+    while (!Trim(rest).empty())
+    {
+      const std::size_t comma = rest.find(',');
+      const auto arg = ParseUnsigned(rest.substr(0, comma));
+      if (!arg || command->args.size() == max_args)
+      {
+        if (error)
+          *error = "args must be up to 8 comma-separated unsigned values";
+        return false;
+      }
+      command->args.push_back(*arg);
+      rest = comma == std::string_view::npos ? std::string_view{} : rest.substr(comma + 1);
+    }
+  }
+
+  if (const auto thread_it = values.find("thread"); thread_it != values.end())
+  {
+    const auto thread = ParseUnsigned(thread_it->second);
+    if (!thread)
+    {
+      if (error)
+        *error = "thread must be an unsigned value";
+      return false;
+    }
+    command->thread = *thread;
+  }
+
+  if (const auto async_it = values.find("async"); async_it != values.end())
+  {
+    const std::string async = Trim(async_it->second);
+    if (async != "0" && async != "1")
+    {
+      if (error)
+        *error = "async must be 0 or 1";
+      return false;
+    }
+    command->async = async == "1";
+  }
+
+  command->address = *address;
+  if (const auto path_it = values.find("path"); path_it != values.end())
+    command->path = Trim(path_it->second);
+  return true;
+}
