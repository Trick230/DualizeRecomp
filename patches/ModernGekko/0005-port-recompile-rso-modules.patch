@@ -0,0 +1,42 @@
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace moderngekko::port
+{
+// Code the game loads at runtime from RSO modules (the Wii SDK's relocatable
+// shared objects). Linked ahead of time at the addresses the game's own
+// loader uses, it can be recompiled like DOL text; the chassis' chunk hash
+// check keeps it native only while RAM holds exactly these bytes.
+struct RsoTextSection
+{
+  std::string module;
+  std::uint32_t address = 0;
+  std::vector<std::uint8_t> bytes;
+};
+
+struct RsoLinkResult
+{
+  std::vector<RsoTextSection> text;
+  // Layout text plus the hash of every file it names, for the module cache key.
+  std::string identity;
+  std::string error;
+
+  explicit operator bool() const { return error.empty(); }
+};
+
+// Layout file, one directive per line ('#' or ';' starts a comment):
+//   sel = <path>                    static module export table (.sel)
+//   static_sections = <addr>...     runtime address of each static section index
+//   module = <path> <base> [<bss>]  RSO loaded in place at <base>; bss allocated at <bss>
+// Paths are relative to the game root. Modules may import from each other.
+RsoLinkResult LinkRsoLayout(const std::filesystem::path& layout,
+                            const std::filesystem::path& game_root);
+
+// Place each section in a free DOL text slot, appending its bytes to the file.
+bool AppendDolTextSections(std::vector<std::uint8_t>& dol,
+                           const std::vector<RsoTextSection>& sections, std::string* error);
+}  // namespace moderngekko::port
