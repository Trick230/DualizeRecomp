@@ -0,0 +1,320 @@
+// moderngekko-native: runs NiGHTS on the native machine, no Dolphin involved.
+//
+//   moderngekko-native --game <extracted disc> --module <recompiled DLL>
+//       [--user <dir>] [--load-state <file>] [--automation-dir <dir>]
+//       [--unthrottled] [--no-vsync] [--idle-pc <hex>]
+//
+// Automation: each file dropped in <dir>/commands holds key=value lines, as
+// for moderngekko-run: command=save_state|load_state with path=<file>;
+// command=pad with port=0..3 and controls (classic_a=1, classic_lx=-0.5, a=1,
+// main_x=1, ...); command=pad_frames, the same held for frames=<n> fields;
+// command=clear_pad; command=stop.
+
+#include "machine.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <string>
+#include <string_view>
+#include <system_error>
+#include <utility>
+#include <thread>
+#include <vector>
+
+#ifdef _WIN32
+#include <windows.h>
+#include <shlobj.h>
+#endif
+
+namespace
+{
+namespace fs = std::filesystem;
+using moderngekko::native::Machine;
+using moderngekko::native::MachineConfig;
+
+fs::path Utf8Path(std::string_view text)
+{
+  return fs::path(std::u8string(text.begin(), text.end()));
+}
+
+fs::path DefaultUserDir()
+{
+#ifdef _WIN32
+  PWSTR local = nullptr;
+  if (SUCCEEDED(SHGetKnownFolderPath(FOLDERID_LocalAppData, 0, nullptr, &local)))
+  {
+    fs::path dir = fs::path(local) / "moderngekko";
+    CoTaskMemFree(local);
+    return dir;
+  }
+#else
+  if (const char* home = std::getenv("HOME"))
+    return fs::path(home) / ".local" / "share" / "moderngekko";
+#endif
+  return "moderngekko";
+}
+
+fs::path ExecutableDir()
+{
+#ifdef _WIN32
+  wchar_t path[MAX_PATH];
+  const DWORD size = GetModuleFileNameW(nullptr, path, MAX_PATH);
+  return fs::path(std::wstring(path, size)).parent_path();
+#else
+  std::error_code error;
+  return fs::read_symlink("/proc/self/exe", error).parent_path();
+#endif
+}
+
+using AutomationPad = Machine::AutomationPad;
+namespace ios = moderngekko::ios;
+
+// Field names follow tools/automation_protocol.cpp.
+struct WiiButton
+{
+  std::string_view name;
+  bool classic;
+  uint16_t bit;
+};
+constexpr WiiButton WII_BUTTONS[] = {
+    {"wii_a", false, ios::WIIMOTE_A},
+    {"wii_b", false, ios::WIIMOTE_B},
+    {"wii_1", false, ios::WIIMOTE_ONE},
+    {"wii_2", false, ios::WIIMOTE_TWO},
+    {"wii_plus", false, ios::WIIMOTE_PLUS},
+    {"wii_minus", false, ios::WIIMOTE_MINUS},
+    {"wii_home", false, ios::WIIMOTE_HOME},
+    {"wii_dpad_up", false, ios::WIIMOTE_UP},
+    {"wii_dpad_down", false, ios::WIIMOTE_DOWN},
+    {"wii_dpad_left", false, ios::WIIMOTE_LEFT},
+    {"wii_dpad_right", false, ios::WIIMOTE_RIGHT},
+    {"classic_a", true, ios::CLASSIC_A},
+    {"classic_b", true, ios::CLASSIC_B},
+    {"classic_x", true, ios::CLASSIC_X},
+    {"classic_y", true, ios::CLASSIC_Y},
+    {"classic_zl", true, ios::CLASSIC_ZL},
+    {"classic_zr", true, ios::CLASSIC_ZR},
+    {"classic_plus", true, ios::CLASSIC_PLUS},
+    {"classic_minus", true, ios::CLASSIC_MINUS},
+    {"classic_home", true, ios::CLASSIC_HOME},
+    {"classic_dpad_up", true, ios::CLASSIC_UP},
+    {"classic_dpad_down", true, ios::CLASSIC_DOWN},
+    {"classic_dpad_left", true, ios::CLASSIC_LEFT},
+    {"classic_dpad_right", true, ios::CLASSIC_RIGHT},
+    {"classic_l", true, ios::CLASSIC_L},
+    {"classic_r", true, ios::CLASSIC_R},
+};
+constexpr std::pair<std::string_view, uint16_t> GC_BUTTONS[] = {
+    {"a", 0x0100},         {"b", 0x0200},          {"x", 0x0400},       {"y", 0x0800},
+    {"start", 0x1000},     {"z", 0x0010},          {"dpad_up", 0x0008}, {"dpad_down", 0x0004},
+    {"dpad_left", 0x0001}, {"dpad_right", 0x0002}, {"l", 0x0040},       {"r", 0x0020},
+};
+
+// Sets one control; false for an unknown name.
+bool SetControl(AutomationPad& pad, std::string_view key, float v)
+{
+  for (const WiiButton& b : WII_BUTTONS)
+  {
+    if (key == b.name)
+    {
+      if (v >= 0.5f)
+        (b.classic ? pad.wii.classic_buttons : pad.wii.buttons) |= b.bit;
+      return true;
+    }
+  }
+  for (const auto& [name, bit] : GC_BUTTONS)
+  {
+    if (key == name)
+    {
+      pad.gc = true;
+      if (v >= 0.5f)
+        pad.gc_buttons |= bit;
+      return true;
+    }
+  }
+  const std::pair<std::string_view, float*> axes[] = {
+      {"classic_lx", &pad.wii.left_x},
+      {"classic_ly", &pad.wii.left_y},
+      {"classic_rx", &pad.wii.right_x},
+      {"classic_ry", &pad.wii.right_y},
+      {"classic_l_analog", &pad.wii.left_trigger},
+      {"classic_r_analog", &pad.wii.right_trigger},
+      {"main_x", &pad.gc_main_x},
+      {"main_y", &pad.gc_main_y},
+      {"c_x", &pad.gc_c_x},
+      {"c_y", &pad.gc_c_y},
+      {"l_analog", &pad.gc_left},
+      {"r_analog", &pad.gc_right},
+  };
+  for (const auto& [name, value] : axes)
+  {
+    if (key == name)
+    {
+      pad.gc |= !key.starts_with("classic_");
+      *value = std::clamp(v, key.ends_with("analog") ? 0.0f : -1.0f, 1.0f);
+      return true;
+    }
+  }
+  return false;
+}
+
+void RunCommand(Machine& machine, const fs::path& file, const std::atomic<bool>& done)
+{
+  std::ifstream in(file);
+  std::string line, command;
+  fs::path path;
+  int port = 0;
+  uint64_t frames = 0;
+  std::vector<std::pair<std::string, std::string>> controls;
+  while (std::getline(in, line))
+  {
+    if (!line.empty() && line.back() == '\r')
+      line.pop_back();
+    const size_t eq = line.find('=');
+    if (eq == std::string::npos)
+      continue;
+    const std::string key = line.substr(0, eq), value = line.substr(eq + 1);
+    if (key == "command")
+      command = value;
+    else if (key == "path")
+      path = Utf8Path(value);
+    else if (key == "port")
+      port = std::atoi(value.c_str());
+    else if (key == "frames")
+      frames = std::strtoull(value.c_str(), nullptr, 10);
+    else
+      controls.emplace_back(key, value);
+  }
+  const std::string name = file.filename().string();
+  if (command == "pad" || command == "pad_frames")
+  {
+    AutomationPad pad;
+    for (const auto& [key, value] : controls)
+    {
+      if (!SetControl(pad, key, std::strtof(value.c_str(), nullptr)))
+        std::fprintf(stderr, "[native] %s: unknown pad field '%s'\n", name.c_str(), key.c_str());
+    }
+    machine.SetAutomationPad(port, &pad);
+    if (command == "pad_frames")
+    {
+      // Held for that many VI fields, then released.
+      const uint64_t start = machine.FieldCount();
+      while (!done && machine.FieldCount() - start < frames)
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+      machine.SetAutomationPad(port, nullptr);
+    }
+  }
+  else if (command == "clear_pad")
+    machine.SetAutomationPad(port, nullptr);
+  else if (command == "save_state" && !path.empty())
+    machine.RequestSave(path);
+  else if (command == "load_state" && !path.empty())
+    machine.RequestLoad(path);
+  else if (command == "stop")
+    machine.RequestStop();
+  else
+    std::fprintf(stderr, "[native] %s: unknown command '%s'\n", name.c_str(), command.c_str());
+}
+
+// Watches <dir>/commands and runs files in name order, deleting each.
+void WatchAutomation(Machine& machine, fs::path dir, const std::atomic<bool>& done)
+{
+  const fs::path commands = dir / "commands";
+  std::error_code error;
+  fs::create_directories(commands, error);
+  while (!done)
+  {
+    std::vector<fs::path> files;
+    for (const fs::directory_entry& entry : fs::directory_iterator(commands, error))
+    {
+      if (entry.is_regular_file(error))
+        files.push_back(entry.path());
+    }
+    std::sort(files.begin(), files.end());
+    for (const fs::path& file : files)
+    {
+      RunCommand(machine, file, done);
+      fs::remove(file, error);
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+  }
+}
+
+int Usage()
+{
+  std::fprintf(stderr, "usage: moderngekko-native --game <dir> --module <dll> [--user <dir>] "
+                       "[--load-state <file>] [--automation-dir <dir>] [--unthrottled] "
+                       "[--no-vsync] [--idle-pc <hex>]\n");
+  return 2;
+}
+}  // namespace
+
+int main(int argc, char** argv)
+{
+#ifdef _WIN32
+  timeBeginPeriod(1);
+#endif
+  MachineConfig config;
+  config.user = DefaultUserDir();
+  config.sys = ExecutableDir() / "Sys";
+  config.idle_pc = 0x8036623C;  // NiGHTS' idle thread loop (see GameSettings/R7EE8P.ini)
+  fs::path load_state, automation;
+  for (int i = 1; i < argc; ++i)
+  {
+    const std::string arg = argv[i];
+    const auto value = [&]() -> const char* { return i + 1 < argc ? argv[++i] : nullptr; };
+    const char* v = nullptr;
+    if (arg == "--game" && (v = value()))
+      config.game = Utf8Path(v);
+    else if (arg == "--module" && (v = value()))
+      config.module = Utf8Path(v);
+    else if (arg == "--user" && (v = value()))
+      config.user = Utf8Path(v);
+    else if (arg == "--load-state" && (v = value()))
+      load_state = Utf8Path(v);
+    else if (arg == "--automation-dir" && (v = value()))
+      automation = Utf8Path(v);
+    else if (arg == "--idle-pc" && (v = value()))
+      config.idle_pc = static_cast<uint32_t>(std::strtoul(v, nullptr, 16));
+    else if (arg == "--unthrottled")
+      config.throttle = false;
+    else if (arg == "--no-vsync")
+      config.vsync = false;
+    else
+      return Usage();
+  }
+  if (config.game.empty() || config.module.empty())
+    return Usage();
+
+  auto machine = std::make_unique<Machine>(config);
+  std::string error;
+  if (!machine->Start(&error))
+  {
+    std::fprintf(stderr, "moderngekko-native: %s\n", error.c_str());
+    return 1;
+  }
+  if (!load_state.empty() && !machine->LoadState(load_state, &error))
+  {
+    std::fprintf(stderr, "moderngekko-native: %s\n", error.c_str());
+    return 1;
+  }
+  std::atomic<bool> done{false};
+  std::thread watcher;
+  if (!automation.empty())
+    watcher = std::thread(WatchAutomation, std::ref(*machine), automation, std::cref(done));
+  machine->Run();
+  done = true;
+  if (watcher.joinable())
+    watcher.join();
+  const auto& stats = machine->cpu.GetStats();
+  std::fprintf(stderr, "[native] dispatches %llu, interpreted %llu, entry misses %llu, fallbacks %llu\n",
+               static_cast<unsigned long long>(stats.dispatches),
+               static_cast<unsigned long long>(stats.interpreted),
+               static_cast<unsigned long long>(stats.entry_misses),
+               static_cast<unsigned long long>(stats.fallbacks));
+  return 0;
+}
diff --git a/src/native/memory.cpp b/src/native/memory.cpp
new file mode 100644
index 0000000..9198e6d
--- /dev/null
+++ b/src/native/memory.cpp
@@ -0,0 +1,229 @@
+#include "memory.hpp"
+
+#include <atomic>
+#include <cstdio>
+
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <csignal>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+namespace moderngekko::native
+{
+namespace
+{
+// 4 GiB plus a guard for accesses that start just below the top.
+constexpr uint64_t SPACE = (uint64_t{1} << 32) + 0x10000;
+// Views are placed at the host's allocation granularity (64 KiB on Windows).
+constexpr uint32_t GRANULE = 0x10000;
+constexpr uint32_t L1_VIEW = GRANULE;
+constexpr uint64_t SECTION = uint64_t{Memory::MEM1_SIZE} + Memory::MEM2_SIZE + L1_VIEW;
+
+struct View
+{
+  uint32_t ea;
+  uint64_t offset;
+  uint32_t size;
+};
+constexpr View VIEWS[] = {
+    {0x80000000, 0, Memory::MEM1_SIZE},
+    {0x90000000, Memory::MEM1_SIZE, Memory::MEM2_SIZE},
+    {0xC0000000, 0, Memory::MEM1_SIZE},
+    {0xD0000000, Memory::MEM1_SIZE, Memory::MEM2_SIZE},
+    {Memory::L1_BASE, uint64_t{Memory::MEM1_SIZE} + Memory::MEM2_SIZE, L1_VIEW},
+};
+
+// The live reservation, for the fault handler (one machine per process).
+std::atomic<uint8_t*> s_flat{nullptr};
+
+void ReportStray(uint8_t* page)
+{
+  std::fprintf(stderr, "[native] guest access to unmapped %08x: backed with zeros\n",
+               static_cast<uint32_t>(page - s_flat.load(std::memory_order_relaxed)));
+}
+
+#ifdef _WIN32
+using VirtualAlloc2Fn = PVOID(WINAPI*)(HANDLE, PVOID, SIZE_T, ULONG, ULONG, void*, ULONG);
+using MapViewOfFile3Fn = PVOID(WINAPI*)(HANDLE, HANDLE, PVOID, ULONG64, SIZE_T, ULONG, ULONG,
+                                        void*, ULONG);
+VirtualAlloc2Fn s_virtual_alloc2;
+MapViewOfFile3Fn s_map_view3;
+PVOID s_handler;
+
+// Placeholder reservations (Windows 10 1803+): split one out exactly where
+// a view or a zero page goes, then replace it.
+bool Split(uint8_t* at, size_t size)
+{
+  MEMORY_BASIC_INFORMATION info;
+  if (!VirtualQuery(at, &info, sizeof(info)) || info.State != MEM_RESERVE)
+    return false;
+  if (info.BaseAddress == at && info.RegionSize == size)
+    return true;
+  return VirtualFree(at, size, MEM_RELEASE | MEM_PRESERVE_PLACEHOLDER) != 0;
+}
+
+LONG CALLBACK StrayAccess(EXCEPTION_POINTERS* info)
+{
+  const EXCEPTION_RECORD* record = info->ExceptionRecord;
+  uint8_t* const flat = s_flat.load(std::memory_order_acquire);
+  if (record->ExceptionCode != EXCEPTION_ACCESS_VIOLATION || record->NumberParameters < 2 ||
+      !flat)
+    return EXCEPTION_CONTINUE_SEARCH;
+  uint8_t* const address = reinterpret_cast<uint8_t*>(record->ExceptionInformation[1]);
+  if (address < flat || address >= flat + SPACE)
+    return EXCEPTION_CONTINUE_SEARCH;
+  uint8_t* const page = flat + ((address - flat) & ~uint64_t{GRANULE - 1});
+  if (!Split(page, GRANULE) ||
+      !s_virtual_alloc2(GetCurrentProcess(), page, GRANULE,
+                        MEM_RESERVE | MEM_COMMIT | MEM_REPLACE_PLACEHOLDER, PAGE_READWRITE,
+                        nullptr, 0))
+    return EXCEPTION_CONTINUE_SEARCH;
+  ReportStray(page);
+  return EXCEPTION_CONTINUE_EXECUTION;
+}
+
+void Release(uint8_t* flat)
+{
+  for (uint8_t* p = flat; p < flat + SPACE;)
+  {
+    MEMORY_BASIC_INFORMATION info;
+    if (!VirtualQuery(p, &info, sizeof(info)))
+      break;
+    if (info.Type == MEM_MAPPED)
+      UnmapViewOfFile(info.AllocationBase);
+    else if (info.State != MEM_FREE)
+      VirtualFree(info.AllocationBase, 0, MEM_RELEASE);
+    p = static_cast<uint8_t*>(info.BaseAddress) + info.RegionSize;
+  }
+}
+#else
+struct sigaction s_previous;
+
+void StrayAccess(int signal, siginfo_t* info, void* context)
+{
+  uint8_t* const flat = s_flat.load(std::memory_order_acquire);
+  uint8_t* const address = static_cast<uint8_t*>(info->si_addr);
+  if (flat && address >= flat && address < flat + SPACE)
+  {
+    uint8_t* const page = flat + ((address - flat) & ~uint64_t{GRANULE - 1});
+    if (mmap(page, GRANULE, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1,
+             0) != MAP_FAILED)
+    {
+      ReportStray(page);
+      return;
+    }
+  }
+  if (s_previous.sa_flags & SA_SIGINFO)
+    s_previous.sa_sigaction(signal, info, context);
+  else if (s_previous.sa_handler != SIG_DFL && s_previous.sa_handler != SIG_IGN)
+    s_previous.sa_handler(signal);
+  else
+  {
+    sigaction(signal, &s_previous, nullptr);
+    raise(signal);
+  }
+}
+#endif
+}  // namespace
+
+Memory::Memory()
+{
+#ifdef _WIN32
+  const HMODULE kernel = GetModuleHandleW(L"kernelbase.dll");
+  s_virtual_alloc2 = kernel ? reinterpret_cast<VirtualAlloc2Fn>(
+                                  reinterpret_cast<void*>(GetProcAddress(kernel, "VirtualAlloc2")))
+                            : nullptr;
+  s_map_view3 = kernel ? reinterpret_cast<MapViewOfFile3Fn>(
+                             reinterpret_cast<void*>(GetProcAddress(kernel, "MapViewOfFile3")))
+                       : nullptr;
+  if (!s_virtual_alloc2 || !s_map_view3)
+    return;
+  HANDLE section = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE,
+                                      static_cast<DWORD>(SECTION >> 32),
+                                      static_cast<DWORD>(SECTION), nullptr);
+  if (!section)
+    return;
+  m_section = section;
+  uint8_t* const base = static_cast<uint8_t*>(
+      s_virtual_alloc2(GetCurrentProcess(), nullptr, SPACE, MEM_RESERVE | MEM_RESERVE_PLACEHOLDER,
+                       PAGE_NOACCESS, nullptr, 0));
+  if (!base)
+    return;
+  for (const View& view : VIEWS)
+  {
+    if (!Split(base + view.ea, view.size) ||
+        !s_map_view3(section, GetCurrentProcess(), base + view.ea, view.offset, view.size,
+                     MEM_REPLACE_PLACEHOLDER, PAGE_READWRITE, nullptr, 0))
+    {
+      Release(base);
+      return;
+    }
+  }
+  s_handler = AddVectoredExceptionHandler(1, StrayAccess);
+#else
+#ifdef __linux__
+  m_fd = memfd_create("moderngekko-ram", 0);
+#else
+  char name[64];
+  std::snprintf(name, sizeof(name), "/moderngekko-ram-%d", static_cast<int>(getpid()));
+  m_fd = shm_open(name, O_RDWR | O_CREAT | O_EXCL, 0600);
+  shm_unlink(name);
+#endif
+  if (m_fd < 0 || ftruncate(m_fd, static_cast<off_t>(SECTION)) != 0)
+    return;
+  void* const reserved =
+      mmap(nullptr, SPACE, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+  if (reserved == MAP_FAILED)
+    return;
+  uint8_t* const base = static_cast<uint8_t*>(reserved);
+  for (const View& view : VIEWS)
+  {
+    if (mmap(base + view.ea, view.size, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED, m_fd,
+             static_cast<off_t>(view.offset)) == MAP_FAILED)
+    {
+      munmap(base, SPACE);
+      return;
+    }
+  }
+  struct sigaction action = {};
+  action.sa_sigaction = StrayAccess;
+  action.sa_flags = SA_SIGINFO | SA_NODEFER;
+  sigemptyset(&action.sa_mask);
+  sigaction(SIGSEGV, &action, &s_previous);
+#ifdef __APPLE__
+  sigaction(SIGBUS, &action, nullptr);
+#endif
+#endif
+  flat = base;
+  mem1 = base + 0x80000000u;
+  mem2 = base + 0x90000000u;
+  l1 = base + L1_BASE;
+  s_flat.store(base, std::memory_order_release);
+}
+
+Memory::~Memory()
+{
+  s_flat.store(nullptr, std::memory_order_release);
+#ifdef _WIN32
+  if (s_handler)
+    RemoveVectoredExceptionHandler(s_handler);
+  s_handler = nullptr;
+  if (flat)
+    Release(flat);
+  if (m_section)
+    CloseHandle(static_cast<HANDLE>(m_section));
+#else
+  if (flat)
+  {
+    sigaction(SIGSEGV, &s_previous, nullptr);
+    munmap(flat, SPACE);
+  }
+  if (m_fd >= 0)
+    close(m_fd);
+#endif
+}
+}  // namespace moderngekko::native
diff --git a/src/native/memory.hpp b/src/native/memory.hpp
new file mode 100644
index 0000000..a5fb359
--- /dev/null
+++ b/src/native/memory.hpp
@@ -0,0 +1,125 @@
+#pragma once
+
+// Guest RAM: MEM1 (24 MiB at physical 0), MEM2 (64 MiB at physical 0x10000000)
+// and the 16 KiB locked L1 cache window the OS maps at 0xE0000000. The OS's
+// BATs map MEM1/MEM2 cached at 0x80000000/0x90000000 and uncached at
+// 0xC0000000/0xD0000000, which is all translation NiGHTS ever uses.
+//
+// All of it lives in one shared-memory section, viewed into a 4 GiB host
+// reservation at those effective addresses (`flat`), so recompiled code
+// reaches guest memory as flat + ea. Nothing is mapped anywhere else: the
+// hardware window goes through the CPU's hooks, and a stray access anywhere
+// in the reservation gets a page of zeros (logged) instead of a crash.
+
+#include <cstdint>
+#include <cstring>
+
+namespace moderngekko::native
+{
+inline uint16_t Load16(const uint8_t* p)
+{
+  uint16_t v;
+  std::memcpy(&v, p, 2);
+  return __builtin_bswap16(v);
+}
+inline uint32_t Load32(const uint8_t* p)
+{
+  uint32_t v;
+  std::memcpy(&v, p, 4);
+  return __builtin_bswap32(v);
+}
+inline uint64_t Load64(const uint8_t* p)
+{
+  uint64_t v;
+  std::memcpy(&v, p, 8);
+  return __builtin_bswap64(v);
+}
+inline void Store16(uint8_t* p, uint16_t v)
+{
+  v = __builtin_bswap16(v);
+  std::memcpy(p, &v, 2);
+}
+inline void Store32(uint8_t* p, uint32_t v)
+{
+  v = __builtin_bswap32(v);
+  std::memcpy(p, &v, 4);
+}
+inline void Store64(uint8_t* p, uint64_t v)
+{
+  v = __builtin_bswap64(v);
+  std::memcpy(p, &v, 8);
+}
+
+class Memory
+{
+public:
+  static constexpr uint32_t MEM1_SIZE = 0x01800000;
+  static constexpr uint32_t MEM2_SIZE = 0x04000000;
+  static constexpr uint32_t MEM2_BASE = 0x10000000;  // physical
+  static constexpr uint32_t L1_SIZE = 0x4000;
+  static constexpr uint32_t L1_BASE = 0xE0000000;  // effective
+
+  // On failure (the host refused the reservation) every pointer stays null.
+  Memory();
+  ~Memory();
+  Memory(const Memory&) = delete;
+  Memory& operator=(const Memory&) = delete;
+
+  // Host bytes for size bytes at a physical address, or null outside RAM.
+  uint8_t* Physical(uint32_t physical, uint32_t size) const
+  {
+    if (physical < MEM1_SIZE && size <= MEM1_SIZE - physical)
+      return mem1 + physical;
+    const uint32_t offset = physical - MEM2_BASE;
+    if (offset < MEM2_SIZE && size <= MEM2_SIZE - offset)
+      return mem2 + offset;
+    return nullptr;
+  }
+  // The same for an effective address under the OS's BAT mapping.
+  uint8_t* Effective(uint32_t address, uint32_t size) const
+  {
+    if ((address >> 30) == 2 || (address >> 30) == 3)
+      return Physical(address & 0x1FFFFFFF, size);
+    return nullptr;
+  }
+
+  uint32_t Read32(uint32_t physical) const
+  {
+    const uint8_t* p = Physical(physical, 4);
+    return p ? Load32(p) : 0;
+  }
+  void Write32(uint32_t physical, uint32_t value) const
+  {
+    if (uint8_t* p = Physical(physical, 4))
+      Store32(p, value);
+  }
+  void Write16(uint32_t physical, uint16_t value) const
+  {
+    if (uint8_t* p = Physical(physical, 2))
+      Store16(p, value);
+  }
+  void Write8(uint32_t physical, uint8_t value) const
+  {
+    if (uint8_t* p = Physical(physical, 1))
+      *p = value;
+  }
+  bool CopyTo(uint32_t physical, const void* data, uint32_t size) const
+  {
+    uint8_t* p = Physical(physical, size);
+    if (p)
+      std::memcpy(p, data, size);
+    return p != nullptr;
+  }
+
+  // The 4 GiB effective address space, and the RAM in it at its cached
+  // addresses.
+  uint8_t* flat = nullptr;
+  uint8_t* mem1 = nullptr;
+  uint8_t* mem2 = nullptr;
+  uint8_t* l1 = nullptr;
+
+private:
+  void* m_section = nullptr;  // Windows: the section handle
+  int m_fd = -1;              // elsewhere: the shared-memory file
+};
+}  // namespace moderngekko::native
diff --git a/src/native/scheduler.cpp b/src/native/scheduler.cpp
new file mode 100644
index 0000000..1986e5a
--- /dev/null
+++ b/src/native/scheduler.cpp
@@ -0,0 +1,135 @@
+#include "scheduler.hpp"
+
+#include <algorithm>
+
+namespace moderngekko::native
+{
+int Scheduler::Register(Callback callback, void* user)
+{
+  m_types.push_back({callback, user});
+  return static_cast<int>(m_types.size() - 1);
+}
+
+void Scheduler::Push(const Event& event)
+{
+  m_heap.push_back(event);
+  std::push_heap(m_heap.begin(), m_heap.end(), Later);
+}
+
+void Scheduler::Schedule(int64_t cycles_into_future, int type, uint64_t userdata)
+{
+  const uint64_t now = Now();
+  const uint64_t time = cycles_into_future > 0 ? now + cycles_into_future : now;
+  ScheduleAt(time, type, userdata);
+}
+
+void Scheduler::ScheduleAt(uint64_t tick, int type, uint64_t userdata)
+{
+  Push({tick, m_order++, userdata, type});
+  // An event inside the running slice cuts it short.
+  const uint64_t now = Now();
+  ForceCheck(tick > now ? static_cast<int64_t>(tick - now) : 0);
+}
+
+void Scheduler::Remove(int type)
+{
+  const auto end = std::remove_if(m_heap.begin(), m_heap.end(),
+                                  [type](const Event& e) { return e.type == type; });
+  if (end == m_heap.end())
+    return;
+  m_heap.erase(end, m_heap.end());
+  std::make_heap(m_heap.begin(), m_heap.end(), Later);
+}
+
+void Scheduler::Remove(int type, uint64_t userdata)
+{
+  const auto end = std::remove_if(m_heap.begin(), m_heap.end(), [&](const Event& e) {
+    return e.type == type && e.userdata == userdata;
+  });
+  if (end == m_heap.end())
+    return;
+  m_heap.erase(end, m_heap.end());
+  std::make_heap(m_heap.begin(), m_heap.end(), Later);
+}
+
+bool Scheduler::IsScheduled(int type) const
+{
+  return std::any_of(m_heap.begin(), m_heap.end(), [type](const Event& e) { return e.type == type; });
+}
+
+void Scheduler::ForceCheck(int64_t cycles)
+{
+  if (cycles < 0)
+    cycles = 0;
+  if (downcount > cycles)
+  {
+    m_slice -= downcount - cycles;
+    downcount = cycles;
+  }
+}
+
+void Scheduler::StartSlice()
+{
+  m_slice_start = Now();
+  int64_t slice = MAX_SLICE;
+  if (!m_heap.empty())
+  {
+    const uint64_t next = m_heap.front().time;
+    slice = next > m_slice_start ? std::min<int64_t>(slice, next - m_slice_start) : 0;
+  }
+  m_slice = slice;
+  downcount = slice;
+}
+
+void Scheduler::Advance()
+{
+  // Time runs on from where the CPU stopped, overshoot included.
+  m_slice_start = Now();
+  m_slice = 0;
+  downcount = 0;
+  while (!m_heap.empty() && m_heap.front().time <= m_slice_start)
+  {
+    std::pop_heap(m_heap.begin(), m_heap.end(), Later);
+    const Event event = m_heap.back();
+    m_heap.pop_back();
+    const Type& type = m_types[event.type];
+    type.callback(type.user, event.userdata, static_cast<int64_t>(m_slice_start - event.time));
+  }
+  StartSlice();
+}
+
+void Scheduler::Idle()
+{
+  if (!m_heap.empty() && m_heap.front().time > Now())
+  {
+    m_slice_start = m_heap.front().time;
+    m_slice = 0;
+    downcount = 0;
+  }
+}
+
+void Scheduler::DoState(StateIO& io)
+{
+  uint64_t now = Now();
+  io.Do(now);
+  io.Do(m_order);
+  uint32_t count = static_cast<uint32_t>(m_heap.size());
+  io.Do(count);
+  if (io.Reading())
+    m_heap.resize(count);
+  for (Event& event : m_heap)
+  {
+    io.Do(event.time);
+    io.Do(event.order);
+    io.Do(event.userdata);
+    io.Do(event.type);
+  }
+  if (io.Reading())
+  {
+    std::make_heap(m_heap.begin(), m_heap.end(), Later);
+    m_slice_start = now;
+    m_slice = 0;
+    downcount = 0;
+  }
+}
+}  // namespace moderngekko::native
diff --git a/src/native/scheduler.hpp b/src/native/scheduler.hpp
new file mode 100644
index 0000000..8bd06b9
--- /dev/null
+++ b/src/native/scheduler.hpp
@@ -0,0 +1,75 @@
+#pragma once
+
+// Guest time: one tick is one CPU cycle (729 MHz). The CPU runs in slices that
+// end at the next event; events fire in time order, ties in scheduling order.
+
+#include "state.hpp"
+
+#include <cstdint>
+#include <vector>
+
+namespace moderngekko::native
+{
+class Scheduler
+{
+public:
+  using Callback = void (*)(void* user, uint64_t userdata, int64_t late);
+  static constexpr uint32_t CPU_CLOCK = 729000000;
+  // Timebase and decrementer count once per this many CPU ticks.
+  static constexpr uint32_t TIMER_RATIO = 12;
+
+  // Event types are saved by index, so they must be registered in the same
+  // order on every run.
+  int Register(Callback callback, void* user);
+
+  void Schedule(int64_t cycles_into_future, int type, uint64_t userdata = 0);
+  // Schedules at an absolute tick.
+  void ScheduleAt(uint64_t tick, int type, uint64_t userdata = 0);
+  void Remove(int type);
+  void Remove(int type, uint64_t userdata);
+  bool IsScheduled(int type) const;
+
+  // The current tick, counting what the CPU has run of its slice.
+  uint64_t Now() const { return m_slice_start + static_cast<uint64_t>(m_slice - downcount); }
+  // Makes the running slice end within cycles ticks.
+  void ForceCheck(int64_t cycles);
+
+  // Ends the slice, runs every due event and starts the next slice.
+  void Advance();
+  // Moves time to the next event (the CPU has nothing to do until then).
+  void Idle();
+
+  void DoState(StateIO& io);
+
+  // Ticks left in the slice; the CPU counts it down.
+  int64_t downcount = 0;
+
+private:
+  struct Event
+  {
+    uint64_t time;
+    uint64_t order;
+    uint64_t userdata;
+    int type;
+  };
+  struct Type
+  {
+    Callback callback;
+    void* user;
+  };
+  static bool Later(const Event& a, const Event& b)
+  {
+    return a.time != b.time ? a.time > b.time : a.order > b.order;
+  }
+  void Push(const Event& event);
+  void StartSlice();
+
+  static constexpr int64_t MAX_SLICE = 20000;
+
+  std::vector<Type> m_types;
+  std::vector<Event> m_heap;  // min-heap on (time, order)
+  uint64_t m_order = 0;
+  uint64_t m_slice_start = 0;
+  int64_t m_slice = 0;
+};
+}  // namespace moderngekko::native
diff --git a/src/native/state.hpp b/src/native/state.hpp
new file mode 100644
index 0000000..dfc1f70
--- /dev/null
+++ b/src/native/state.hpp
@@ -0,0 +1,90 @@
+#pragma once
+
+// Savestate stream: raw little-endian PODs in declaration order, one buffer for
+// the whole machine. A section marker after each component catches layout
+// drift at load instead of letting it corrupt what follows.
+
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace moderngekko::native
+{
+class StateIO
+{
+public:
+  // Writing appends to buffer; reading consumes it from the start.
+  StateIO(std::vector<uint8_t>& buffer, bool reading) : m_buffer(buffer), m_reading(reading) {}
+
+  bool Reading() const { return m_reading; }
+  // False once a read ran past the end or hit a bad marker.
+  bool Ok() const { return m_ok; }
+
+  void Bytes(void* data, size_t size)
+  {
+    if (m_reading)
+    {
+      if (!m_ok || size > m_buffer.size() - m_cursor)
+      {
+        m_ok = false;
+        std::memset(data, 0, size);
+        return;
+      }
+      std::memcpy(data, m_buffer.data() + m_cursor, size);
+      m_cursor += size;
+    }
+    else
+    {
+      const uint8_t* bytes = static_cast<const uint8_t*>(data);
+      m_buffer.insert(m_buffer.end(), bytes, bytes + size);
+    }
+  }
+  template <typename T>
+  void Do(T& value)
+  {
+    static_assert(std::is_trivially_copyable_v<T>);
+    Bytes(&value, sizeof(T));
+  }
+  void Do(bool& value)
+  {
+    uint8_t v = value;
+    Do(v);
+    value = v != 0;
+  }
+  void Do(std::string& value)
+  {
+    uint32_t size = static_cast<uint32_t>(value.size());
+    Do(size);
+    if (m_reading)
+      value.resize(m_ok ? size : 0);
+    if (!value.empty())
+      Bytes(value.data(), value.size());
+  }
+  template <typename T>
+  void Do(std::vector<T>& values)
+  {
+    static_assert(std::is_trivially_copyable_v<T>);
+    uint32_t size = static_cast<uint32_t>(values.size());
+    Do(size);
+    if (m_reading)
+      values.resize(m_ok && size <= m_buffer.size() - m_cursor ? size : 0);
+    if (!values.empty())
+      Bytes(values.data(), values.size() * sizeof(T));
+  }
+  void Marker(uint32_t id)
+  {
+    uint32_t value = id;
+    Do(value);
+    if (m_reading && value != id)
+      m_ok = false;
+  }
+
+private:
+  std::vector<uint8_t>& m_buffer;
+  size_t m_cursor = 0;
+  bool m_reading;
+  bool m_ok = true;
+};
+}  // namespace moderngekko::native
