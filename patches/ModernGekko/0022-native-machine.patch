+    case 86:   // dcbf
+    case 470:  // dcbi
+      ppc_cache_control(&c, x10 == 54 ? PPC_CACHE_DCBST : x10 == 86 ? PPC_CACHE_DCBF : PPC_CACHE_DCBI,
+                        ea_x(), cia);
+      cycles = 5;
+      break;
+    case 982:  // icbi
+      ppc_cache_control(&c, PPC_CACHE_ICBI, ea_x(), cia);
+      cycles = 4;
+      break;
+    case 246:  // dcbtst
+    case 278:  // dcbt
+      cycles = 2;
+      break;
+    case 598:  // sync
+      cycles = 3;
+      break;
+    case 854:  // eieio
+    case 566:  // tlbsync
+      break;
+    case 306:  // tlbie
+      ppc_tlbie(&c, c.gpr[rb], cia);
+      break;
+    case 310:  // eciwx
+    {
+      const uint32_t value = ppc_eciwx(&c, ea_x(), cia);
+      if (!c.exception)
+        c.gpr[rd] = value;
+      break;
+    }
+    case 438:  // ecowx
+      ppc_ecowx(&c, ea_x(), c.gpr[rs], cia);
+      break;
+
+    default:
+    {
+      // XO-form arithmetic, with or without OE.
+      const bool oe = x10 & 0x200;
+      const uint32_t a = c.gpr[ra], b = c.gpr[rb];
+      uint32_t res;
+      switch (x10 & 0x1FF)
+      {
+      case 266:  // add
+        res = a + b;
+        if (oe)
+          ppc_set_xer_ov(&c, ppc_add_overflowed(a, b, res));
+        break;
+      case 10:  // addc
+      {
+        const uint64_t wide = static_cast<uint64_t>(a) + b;
+        res = static_cast<uint32_t>(wide);
+        SetCarry(c, wide >> 32);
+        if (oe)
+          ppc_set_xer_ov(&c, ppc_add_overflowed(a, b, res));
+        break;
+      }
+      case 138:  // adde
+      {
+        const uint64_t wide = static_cast<uint64_t>(a) + b + Carry(c);
+        res = static_cast<uint32_t>(wide);
+        SetCarry(c, wide >> 32);
+        if (oe)
+          ppc_set_xer_ov(&c, ppc_add_overflowed(a, b, res));
+        break;
+      }
+      case 234:  // addme
+      {
+        const uint64_t wide = static_cast<uint64_t>(a) + 0xFFFFFFFFull + Carry(c);
+        res = static_cast<uint32_t>(wide);
+        SetCarry(c, wide >> 32);
+        if (oe)
+          ppc_set_xer_ov(&c, ppc_add_overflowed(a, 0xFFFFFFFFu, res));
+        break;
+      }
+      case 202:  // addze
+      {
+        const uint64_t wide = static_cast<uint64_t>(a) + Carry(c);
+        res = static_cast<uint32_t>(wide);
+        SetCarry(c, wide >> 32);
+        if (oe)
+          ppc_set_xer_ov(&c, ppc_add_overflowed(a, 0u, res));
+        break;
+      }
+      case 40:  // subf
+        res = ~a + b + 1u;
+        if (oe)
+          ppc_set_xer_ov(&c, ppc_add_overflowed(~a, b, res));
+        break;
+      case 8:  // subfc
+      {
+        const uint64_t wide = static_cast<uint64_t>(b) + (~a) + 1u;
+        res = static_cast<uint32_t>(wide);
+        SetCarry(c, wide >> 32);
+        if (oe)
+          ppc_set_xer_ov(&c, ppc_add_overflowed(~a, b, res));
+        break;
+      }
+      case 136:  // subfe
+      {
+        const uint64_t wide = static_cast<uint64_t>(~a) + b + Carry(c);
+        res = static_cast<uint32_t>(wide);
+        SetCarry(c, wide >> 32);
+        if (oe)
+          ppc_set_xer_ov(&c, ppc_add_overflowed(~a, b, res));
+        break;
+      }
+      case 232:  // subfme
+      {
+        const uint64_t wide = static_cast<uint64_t>(~a) + 0xFFFFFFFFull + Carry(c);
+        res = static_cast<uint32_t>(wide);
+        SetCarry(c, wide >> 32);
+        if (oe)
+          ppc_set_xer_ov(&c, ppc_add_overflowed(~a, 0xFFFFFFFFu, res));
+        break;
+      }
+      case 200:  // subfze
+      {
+        const uint64_t wide = static_cast<uint64_t>(~a) + Carry(c);
+        res = static_cast<uint32_t>(wide);
+        SetCarry(c, wide >> 32);
+        if (oe)
+          ppc_set_xer_ov(&c, ppc_add_overflowed(~a, 0u, res));
+        break;
+      }
+      case 104:  // neg
+        res = ~a + 1u;
+        if (oe)
+          ppc_set_xer_ov(&c, a == 0x80000000u);
+        break;
+      case 235:  // mullw
+      {
+        const int64_t product = static_cast<int64_t>(static_cast<int32_t>(a)) * static_cast<int32_t>(b);
+        res = static_cast<uint32_t>(product);
+        if (oe)
+          ppc_set_xer_ov(&c, product < -0x80000000ll || product > 0x7fffffffll);
+        cycles = 5;
+        break;
+      }
+      case 75:  // mulhw
+        res = static_cast<uint32_t>((static_cast<int64_t>(static_cast<int32_t>(a)) * static_cast<int32_t>(b)) >> 32);
+        cycles = 5;
+        break;
+      case 11:  // mulhwu
+        res = static_cast<uint32_t>((static_cast<uint64_t>(a) * b) >> 32);
+        cycles = 5;
+        break;
+      case 491:  // divw
+      {
+        const int32_t dividend = static_cast<int32_t>(a), divisor = static_cast<int32_t>(b);
+        const bool ov = divisor == 0 || (a == 0x80000000u && divisor == -1);
+        res = ov ? (dividend < 0 ? 0xFFFFFFFFu : 0u) : static_cast<uint32_t>(dividend / divisor);
+        if (oe)
+          ppc_set_xer_ov(&c, ov);
+        cycles = 40;
+        break;
+      }
+      case 459:  // divwu
+        res = b == 0 ? 0u : a / b;
+        if (oe)
+          ppc_set_xer_ov(&c, b == 0);
+        cycles = 40;
+        break;
+      default:
+        illegal();
+        goto done;
+      }
+      c.gpr[rd] = res;
+      if (rc)
+        SetCr0(c, res);
+      break;
+    }
+    }
+    break;
+  }
+
+  // Loads and stores, D-form.
+  case 32:  // lwz
+  case 33:  // lwzu
+  case 34:  // lbz
+  case 35:  // lbzu
+  case 40:  // lhz
+  case 41:  // lhzu
+  case 42:  // lha
+  case 43:  // lhau
+  {
+    const bool update = op & 1;
+    const uint32_t ea = update ? c.gpr[ra] + static_cast<uint32_t>(simm) : ea_d();
+    const uint32_t a = da(ea);
+    uint32_t value;
+    switch (op & ~1u)
+    {
+    case 32: value = mem_read32_at(&c, cia, a); break;
+    case 34: value = mem_read8_at(&c, cia, a); break;
+    case 40: value = mem_read16_at(&c, cia, a); break;
+    default:
+      value = static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(mem_read16_at(&c, cia, a))));
+      break;
+    }
+    c.gpr[rd] = value;
+    if (update)
+      c.gpr[ra] = ea;
+    break;
+  }
+  case 36:  // stw
+  case 37:  // stwu
+  case 38:  // stb
+  case 39:  // stbu
+  case 44:  // sth
+  case 45:  // sthu
+  {
+    const bool update = op & 1;
+    const uint32_t ea = update ? c.gpr[ra] + static_cast<uint32_t>(simm) : ea_d();
+    const uint32_t a = da(ea);
+    switch (op & ~1u)
+    {
+    case 36: mem_write32_at(&c, cia, a, c.gpr[rd]); break;
+    case 38: mem_write8_at(&c, cia, a, static_cast<u8>(c.gpr[rd])); break;
+    default: mem_write16_at(&c, cia, a, static_cast<u16>(c.gpr[rd])); break;
+    }
+    if (update)
+      c.gpr[ra] = ea;
+    break;
+  }
+  case 46:  // lmw
+  {
+    uint32_t ea = ea_d();
+    for (uint32_t r = rd; r < 32; ++r, ea += 4)
+      c.gpr[r] = mem_read32_at(&c, cia, da(ea));
+    cycles = 11;
+    break;
+  }
+  case 47:  // stmw
+  {
+    uint32_t ea = ea_d();
+    for (uint32_t r = rd; r < 32; ++r, ea += 4)
+      mem_write32_at(&c, cia, da(ea), c.gpr[r]);
+    cycles = 11;
+    break;
+  }
+  case 48:  // lfs
+  case 49:  // lfsu
+  case 50:  // lfd
+  case 51:  // lfdu
+  case 52:  // stfs
+  case 53:  // stfsu
+  case 54:  // stfd
+  case 55:  // stfdu
+  {
+    if (!fp_ok())
+      break;
+    const bool update = op & 1;
+    const uint32_t ea = update ? c.gpr[ra] + static_cast<uint32_t>(simm) : ea_d();
+    const uint32_t a = da(ea);
+    switch (op & ~1u)
+    {
+    case 48: c.fpr[rd] = c.ps1[rd] = FromSingleBits(mem_read32_at(&c, cia, a)); break;
+    case 50: c.fpr[rd] = F64(mem_read64_at(&c, cia, a)); break;
+    case 52: mem_write32_at(&c, cia, a, ToSingleBits(c.fpr[rd])); break;
+    default: mem_write64_at(&c, cia, a, Bits(c.fpr[rd])); break;
+    }
+    if (update)
+      c.gpr[ra] = ea;
+    break;
+  }
+  case 56:  // psq_l
+  case 57:  // psq_lu
+  case 60:  // psq_st
+  case 61:  // psq_stu
+  {
+    if (!fp_ok())
+      break;
+    const bool update = op & 1;
+    const int32_t offset = static_cast<int32_t>(static_cast<uint32_t>(raw & 0xFFF) << 20) >> 20;
+    const uint32_t ea = (update || ra ? c.gpr[ra] : 0u) + static_cast<uint32_t>(offset);
+    const bool w = (raw >> 15) & 1;
+    const uint8_t i = static_cast<uint8_t>((raw >> 12) & 7);
+    const bool ok = op >= 60 ? ppc_psq_store_inline(&c, static_cast<u8>(rd), da(ea), w, i, false, cia) :
+                               ppc_psq_load_inline(&c, static_cast<u8>(rd), da(ea), w, i, false, cia);
+    if (ok && !c.exception && update)
+      c.gpr[ra] = ea;
+    break;
+  }
+
+  case 59:  // single-precision arithmetic
+  {
+    if (!fp_ok())
+      break;
+    switch ((raw >> 1) & 0x1F)
+    {
+    case 18:
+      ppc_fdivs_inline(&c, rd, ra, rb);
+      cycles = 17;
+      break;
+    case 20:
+      ppc_fsubs_inline(&c, rd, ra, rb);
+      break;
+    case 21:
+      ppc_fadds_inline(&c, rd, ra, rb);
+      break;
+    case 24:  // fres
+    {
+      double result;
+      if (ppc_fres(&c, c.fpr[rb], &result))
+        c.fpr[rd] = c.ps1[rd] = result;
+      break;
+    }
+    case 25:
+      ppc_fmuls_inline(&c, rd, ra, rc_reg);
+      break;
+    case 28:  // fmsubs
+    case 29:  // fmadds
+    case 30:  // fnmsubs
+    case 31:  // fnmadds
+    {
+      const uint32_t x5 = (raw >> 1) & 0x1F;
+      double result;
+      if (ppc_fma_inline(&c, c.fpr[ra], c.fpr[rc_reg], c.fpr[rb], true, x5 == 28 || x5 == 30,
+                         x5 >= 30, &result))
+        c.fpr[rd] = c.ps1[rd] = result;
+      break;
+    }
+    default:
+      illegal();
+      goto done;
+    }
+    if (rc && !c.exception)
+      SetCr1(c);
+    break;
+  }
+
+  case 63:  // double-precision arithmetic and FPSCR
+  {
+    if (!fp_ok())
+      break;
+    const uint32_t x5 = (raw >> 1) & 0x1F;
+    if (x5 >= 16)
+    {
+      switch (x5)
+      {
+      case 18:
+        ppc_fdiv_inline(&c, rd, ra, rb);
+        cycles = 31;
+        break;
+      case 20:
+        ppc_fsub_inline(&c, rd, ra, rb);
+        break;
+      case 21:
+        ppc_fadd_inline(&c, rd, ra, rb);
+        break;
+      case 23:  // fsel
+        c.fpr[rd] = c.fpr[ra] >= 0.0 ? c.fpr[rc_reg] : c.fpr[rb];
+        break;
+      case 25:
+        ppc_fmul_inline(&c, rd, ra, rc_reg);
+        break;
+      case 26:  // frsqrte
+      {
+        double result;
+        if (ppc_frsqrte(&c, c.fpr[rb], &result))
+          c.fpr[rd] = result;
+        break;
+      }
+      case 28:  // fmsub
+      case 29:  // fmadd
+      case 30:  // fnmsub
+      case 31:  // fnmadd
+      {
+        double result;
+        if (ppc_fma_inline(&c, c.fpr[ra], c.fpr[rc_reg], c.fpr[rb], false, x5 == 28 || x5 == 30,
+                           x5 >= 30, &result))
+          c.fpr[rd] = result;
+        break;
+      }
+      default:
+        illegal();
+        goto done;
+      }
+      if (rc && !c.exception)
+        SetCr1(c);
+      break;
+    }
+    switch (x10)
+    {
+    case 0:   // fcmpu
+    case 32:  // fcmpo
+      ppc_fcmp_inline(&c, static_cast<u8>(rd >> 2), c.fpr[ra], c.fpr[rb], x10 == 32);
+      goto done;
+    case 12:  // frsp
+      ppc_frsp_inline(&c, rd, rb);
+      break;
+    case 14:  // fctiw
+    case 15:  // fctiwz
+    {
+      uint64_t result;
+      if (ppc_fctiw(&c, c.fpr[rb], x10 == 15, &result))
+        c.fpr[rd] = F64(result);
+      break;
+    }
+    case 38:  // mtfsb1
+    case 70:  // mtfsb0
+    {
+      const uint32_t mask = 0x80000000u >> rd;
+      if (rd != 1 && rd != 2)
+        c.fpscr = x10 == 38 ? c.fpscr | mask : c.fpscr & ~mask;
+      cycles = 3;
+      break;
+    }
+    case 40:  // fneg
+      c.fpr[rd] = F64(Bits(c.fpr[rb]) ^ 0x8000000000000000ull);
+      break;
+    case 72:  // fmr
+      c.fpr[rd] = c.fpr[rb];
+      break;
+    case 136:  // fnabs
+      c.fpr[rd] = F64(Bits(c.fpr[rb]) | 0x8000000000000000ull);
+      break;
+    case 264:  // fabs
+      c.fpr[rd] = F64(Bits(c.fpr[rb]) & 0x7FFFFFFFFFFFFFFFull);
+      break;
+    case 64:  // mcrfs
+    {
+      const uint32_t shift = CrShift(ra >> 2);
+      const uint32_t field = (c.fpscr >> shift) & 0xF;
+      c.fpscr &= ~((0xFu << shift) & 0x83F80700u);
+      ppc_fpscr_updated(&c);
+      c.cr = (c.cr & ~(0xFu << CrShift(rd >> 2))) | (field << CrShift(rd >> 2));
+      goto done;
+    }
+    case 134:  // mtfsfi
+    {
+      const uint32_t shift = CrShift(rd >> 2);
+      c.fpscr = (c.fpscr & ~(0xFu << shift)) | (((raw >> 12) & 0xF) << shift);
+      ppc_fpscr_updated(&c);
+      cycles = 3;
+      break;
+    }
+    case 583:  // mffs
+      c.fpr[rd] = F64(0xFFF8000000000000ull | c.fpscr);
+      break;
+    case 711:  // mtfsf
+    {
+      const uint32_t fm = (raw >> 17) & 0xFF;
+      uint32_t mask = 0;
+      for (uint32_t i = 0; i < 8; ++i)
+        if (fm & (1u << i))
+          mask |= 0xFu << (i * 4);
+      c.fpscr = (c.fpscr & ~mask) | (static_cast<uint32_t>(Bits(c.fpr[rb])) & mask);
+      ppc_fpscr_updated(&c);
+      cycles = 3;
+      break;
+    }
+    default:
+      illegal();
+      goto done;
+    }
+    if (rc && !c.exception)
+      SetCr1(c);
+    break;
+  }
+
+  default:
+    illegal();
+    break;
+  }
+
+done:
+  if (c.exception)
+  {
+    // The helper already moved pc to the vector.
+    c.exception = 0;
+    c.program_exception = 0;
+  }
+  else
+  {
+    c.pc = next;
+  }
+  return cycles;
+}
+}  // namespace moderngekko::native
diff --git a/src/native/ios_kernel.cpp b/src/native/ios_kernel.cpp
new file mode 100644
index 0000000..3547ee3
--- /dev/null
+++ b/src/native/ios_kernel.cpp
@@ -0,0 +1,281 @@
+#include "ios_kernel.hpp"
+
+#include "machine.hpp"
+
+#include <cstdio>
+
+namespace moderngekko::native
+{
+namespace
+{
+// A device's id is its index here.
+constexpr std::string_view DEVICES[] = {
+    "/dev/di",           "/dev/stm/eventhook",
+    "/dev/stm/immediate", "/dev/net/kd/request",
+    "/dev/net/kd/time",  "/dev/fs",
+    "/dev/es",           "/dev/usb/oh1/57e/305",
+};
+constexpr int FS = 5;
+constexpr int ES = 6;
+constexpr int BLUETOOTH = 7;
+constexpr uint32_t IPC_REPLY = 8;
+
+// The devices' state streams over the machine's.
+ios::StateIO DeviceStream(StateIO& io)
+{
+  return ios::StateIO(
+      &io, [](void* user, void* data, uint32_t size) { static_cast<StateIO*>(user)->Bytes(data, size); },
+      io.Reading());
+}
+}  // namespace
+
+IosKernel::IosKernel(Machine& machine) : m_machine(machine), m_memory(m_host)
+{
+  m_fds.fill(-1);
+  Scheduler& scheduler = machine.scheduler;
+  m_queue_event = scheduler.Register(QueueEvent, this);
+  m_device_event = scheduler.Register(DeviceEvent, this);
+  m_update_event = scheduler.Register(UpdateEvent, this);
+  m_update_period = Scheduler::CPU_CLOCK / 1500;
+  m_host = ios::Host{
+      .user = this,
+      .mem1 = machine.memory.mem1,
+      .mem1_size = Memory::MEM1_SIZE,
+      .mem2 = machine.memory.mem2,
+      .mem2_size = Memory::MEM2_SIZE,
+      .ticks_per_second = Scheduler::CPU_CLOCK,
+      .reply = HostReply,
+      .schedule = HostSchedule,
+      .now = HostNow,
+  };
+}
+
+IosKernel::~IosKernel() = default;
+
+void IosKernel::Start(const ios::Config& config)
+{
+  m_config = config;
+  // Devices call these with Host::user, the kernel.
+  m_config.emulated_time = [](void* user) {
+    return static_cast<IosKernel*>(user)->m_machine.EmulatedTime();
+  };
+  m_config.shutdown = [](void* user) { static_cast<IosKernel*>(user)->m_machine.RequestStop(); };
+  m_devices.clear();
+  m_devices.resize(std::size(DEVICES));
+  auto nand = ios::CreateFs(m_host, m_config);
+  m_nand = nand.get();
+  auto es = ios::CreateEs(m_host, *m_nand);
+  m_es = es.get();
+  m_devices[FS] = std::move(nand);
+  m_devices[ES] = std::move(es);
+  m_devices[BLUETOOTH] = ios::CreateBluetooth(m_host, m_config, *m_nand);
+  for (uint32_t id = 0; id < std::size(DEVICES); ++id)
+  {
+    if (!m_devices[id])
+      m_devices[id] = ios::CreateDevice(m_host, m_config, DEVICES[id], id);
+  }
+  m_machine.scheduler.Schedule(m_update_period, m_update_event);
+}
+
+int IosKernel::DeviceId(std::string_view name) const
+{
+  for (int id = 0; id < static_cast<int>(std::size(DEVICES)); ++id)
+  {
+    if (DEVICES[id] == name)
+      return m_devices[id] ? id : -1;
+  }
+  return -1;
+}
+
+void IosKernel::InitIpc()
+{
+  m_machine.hollywood.GenerateAck();
+}
+
+void IosKernel::EnqueueRequest(uint32_t address)
+{
+  // Hardware acknowledges 456 to 658 timebase ticks after the doorbell.
+  m_machine.scheduler.Schedule(ios::Tb(500), m_queue_event, address | REQUEST_FLAG);
+}
+
+void IosKernel::UpdateIpc()
+{
+  Hollywood& hollywood = m_machine.hollywood;
+  if (!hollywood.Ready())
+    return;
+  if (!m_requests.empty())
+  {
+    const uint32_t address = m_requests.front();
+    m_requests.pop_front();
+    hollywood.ClearX1();
+    hollywood.GenerateAck();
+    ExecuteCommand(address);
+    return;
+  }
+  if (!m_replies.empty())
+  {
+    hollywood.GenerateReply(m_replies.front());
+    m_replies.pop_front();
+  }
+}
+
+void IosKernel::ExecuteCommand(uint32_t address)
+{
+  const uint32_t command = m_memory.Read32(address);
+  std::optional<ios::Reply> reply = HandleCommand(address);
+  if (!reply)
+    return;
+  // Replies go out in order.
+  const uint64_t now = m_machine.scheduler.Now();
+  if (m_last_reply_time > now)
+    reply->delay += static_cast<int64_t>(m_last_reply_time - now);
+  m_last_reply_time = now + static_cast<uint64_t>(reply->delay);
+  EnqueueReply(address, command, reply->value, reply->delay);
+}
+
+std::optional<ios::Reply> IosKernel::HandleCommand(uint32_t address)
+{
+  const ios::Memory& memory = m_memory;
+  const ios::Request request(memory, address);
+  if (request.command < ios::IPC_CMD_OPEN || request.command > ios::IPC_CMD_IOCTLV)
+    return ios::Reply{ios::IPC_EINVAL, ios::Tb(978)};
+  if (request.command == ios::IPC_CMD_OPEN)
+  {
+    ios::OpenRequest open(memory, address);
+    return Open(open);
+  }
+  const uint32_t fd = static_cast<uint32_t>(request.fd);
+  if (fd >= MAX_FDS || m_fds[fd] < 0)
+    return ios::Reply{ios::IPC_EINVAL, ios::Tb(550)};
+  ios::Device& device = *m_devices[m_fds[fd]];
+  switch (request.command)
+  {
+  case ios::IPC_CMD_CLOSE:
+    m_fds[fd] = -1;
+    return device.Close(request.fd);
+  case ios::IPC_CMD_READ:
+    return device.Read(ios::ReadWriteRequest(memory, address));
+  case ios::IPC_CMD_WRITE:
+    return device.Write(ios::ReadWriteRequest(memory, address));
+  case ios::IPC_CMD_SEEK:
+    return device.Seek(ios::SeekRequest(memory, address));
+  case ios::IPC_CMD_IOCTL:
+    return device.IOCtl(ios::IOCtlRequest(memory, address));
+  default:
+    return device.IOCtlV(ios::IOCtlVRequest(memory, address));
+  }
+}
+
+std::optional<ios::Reply> IosKernel::Open(ios::OpenRequest& request)
+{
+  int fd = -1;
+  for (uint32_t i = 0; i < MAX_FDS && fd < 0; ++i)
+  {
+    if (m_fds[i] < 0)
+      fd = static_cast<int>(i);
+  }
+  if (fd < 0)
+    return ios::Reply{ios::IPC_EMAX, ios::Tb(5000)};
+  request.fd = fd;
+
+  int id = -1;
+  if (request.path.starts_with("/dev/"))
+    id = DeviceId(request.path);
+  else if (request.path.starts_with('/'))
+    id = FS;
+  if (id < 0)
+  {
+    std::fprintf(stderr, "[native-ios] unknown device %s\n", request.path.c_str());
+    return ios::Reply{ios::IPC_ENOENT, ios::Tb(3700)};
+  }
+  std::optional<ios::Reply> reply = m_devices[id]->Open(request);
+  if (reply && reply->value >= ios::IPC_SUCCESS)
+  {
+    m_fds[fd] = static_cast<int8_t>(id);
+    reply->value = fd;
+  }
+  return reply;
+}
+
+void IosKernel::EnqueueReply(uint32_t address, uint32_t command, int32_t value, int64_t delay)
+{
+  const ios::Memory& memory = m_memory;
+  memory.Write32(address + 4, static_cast<uint32_t>(value));
+  // IOS writes the command it answers into the fd field and marks the block
+  // a reply.
+  memory.Write32(address + 8, command);
+  memory.Write32(address, IPC_REPLY);
+  m_machine.scheduler.Schedule(delay, m_queue_event, address);
+}
+
+void IosKernel::QueueEvent(void* user, uint64_t userdata, int64_t)
+{
+  IosKernel& kernel = *static_cast<IosKernel*>(user);
+  if (userdata & REQUEST_FLAG)
+    kernel.m_requests.push_back(static_cast<uint32_t>(userdata));
+  else
+    kernel.m_replies.push_back(static_cast<uint32_t>(userdata));
+  kernel.UpdateIpc();
+}
+
+void IosKernel::DeviceEvent(void* user, uint64_t userdata, int64_t)
+{
+  IosKernel& kernel = *static_cast<IosKernel*>(user);
+  const uint32_t id = static_cast<uint32_t>(userdata >> 40);
+  if (id < kernel.m_devices.size() && kernel.m_devices[id])
+  {
+    kernel.m_devices[id]->Event(static_cast<uint32_t>(userdata >> 32) & 0xFF,
+                                static_cast<uint32_t>(userdata));
+  }
+}
+
+void IosKernel::UpdateEvent(void* user, uint64_t, int64_t late)
+{
+  IosKernel& kernel = *static_cast<IosKernel*>(user);
+  for (const auto& device : kernel.m_devices)
+  {
+    if (device && device->Active())
+      device->Update();
+  }
+  kernel.m_machine.scheduler.Schedule(kernel.m_update_period - late, kernel.m_update_event);
+}
+
+void IosKernel::HostReply(void* user, uint32_t address, int32_t value, int64_t delay)
+{
+  IosKernel& kernel = *static_cast<IosKernel*>(user);
+  kernel.EnqueueReply(address, kernel.m_memory.Read32(address), value, delay);
+}
+
+void IosKernel::HostSchedule(void* user, int64_t cycles, uint32_t device, uint32_t event,
+                             uint32_t data)
+{
+  IosKernel& kernel = *static_cast<IosKernel*>(user);
+  kernel.m_machine.scheduler.Schedule(
+      cycles, kernel.m_device_event, uint64_t{device} << 40 | uint64_t{event & 0xFF} << 32 | data);
+}
+
+uint64_t IosKernel::HostNow(void* user)
+{
+  return static_cast<IosKernel*>(user)->m_machine.scheduler.Now();
+}
+
+void IosKernel::DoState(StateIO& io)
+{
+  io.Do(m_fds);
+  io.Do(m_last_reply_time);
+  for (std::deque<uint32_t>* queue : {&m_requests, &m_replies})
+  {
+    std::vector<uint32_t> items(queue->begin(), queue->end());
+    io.Do(items);
+    if (io.Reading())
+      queue->assign(items.begin(), items.end());
+  }
+  ios::StateIO device_io = DeviceStream(io);
+  for (const auto& device : m_devices)
+  {
+    if (device)
+      device->DoState(device_io);
+  }
+  io.Marker(0x105C0DE);
+}
+}  // namespace moderngekko::native
diff --git a/src/native/ios_kernel.hpp b/src/native/ios_kernel.hpp
new file mode 100644
index 0000000..6a20da5
--- /dev/null
+++ b/src/native/ios_kernel.hpp
@@ -0,0 +1,75 @@
+#pragma once
+
+// The IOS kernel as the PPC sees it through the IPC mailbox: the fd table,
+// request and reply queues with Dolphin's timings (acknowledge 500 timebase
+// ticks after the doorbell, replies kept in order), routing of /dev/ paths to
+// the native devices and other paths to the NAND, and the devices' timed
+// events and periodic update.
+
+#include "ios/devices.hpp"
+#include "state.hpp"
+
+#include <array>
+#include <deque>
+#include <memory>
+#include <string_view>
+
+namespace moderngekko::native
+{
+class Machine;
+
+class IosKernel
+{
+public:
+  explicit IosKernel(Machine& machine);
+  ~IosKernel();
+  // Creates the devices; the disc and NAND come from config.
+  void Start(const ios::Config& config);
+
+  // Hollywood: the PPC rang the doorbell with a request at address.
+  void EnqueueRequest(uint32_t address);
+  // Hollywood: the mailbox may be free; sends the next ack or reply.
+  void UpdateIpc();
+  // The boot's ES_GenerateAck at IPC init.
+  void InitIpc();
+
+  ios::Nand& Nand() { return *m_nand; }
+  ios::Es& Es() { return *m_es; }
+  const ios::Host& Host() const { return m_host; }
+
+  void DoState(StateIO& io);
+
+private:
+  static constexpr uint32_t MAX_FDS = 0x18;
+  static constexpr uint64_t REQUEST_FLAG = 1ull << 32;
+
+  void ExecuteCommand(uint32_t address);
+  std::optional<ios::Reply> HandleCommand(uint32_t address);
+  std::optional<ios::Reply> Open(ios::OpenRequest& request);
+  void EnqueueReply(uint32_t address, uint32_t command, int32_t value, int64_t delay);
+  int DeviceId(std::string_view name) const;
+
+  static void QueueEvent(void* user, uint64_t userdata, int64_t late);
+  static void DeviceEvent(void* user, uint64_t userdata, int64_t late);
+  static void UpdateEvent(void* user, uint64_t userdata, int64_t late);
+  static void HostReply(void* user, uint32_t address, int32_t value, int64_t delay);
+  static void HostSchedule(void* user, int64_t cycles, uint32_t device, uint32_t event,
+                           uint32_t data);
+  static uint64_t HostNow(void* user);
+
+  Machine& m_machine;
+  ios::Host m_host;
+  ios::Memory m_memory;
+  ios::Config m_config;
+  int m_queue_event = -1, m_device_event = -1, m_update_event = -1;
+  int64_t m_update_period = 0;
+
+  // Fixed ids: pending device events and the fd table save them.
+  std::vector<std::unique_ptr<ios::Device>> m_devices;
+  ios::Nand* m_nand = nullptr;
+  ios::Es* m_es = nullptr;
+  std::array<int8_t, MAX_FDS> m_fds;  // device id, -1 free
+  std::deque<uint32_t> m_requests, m_replies;
+  uint64_t m_last_reply_time = 0;
+};
+}  // namespace moderngekko::native
