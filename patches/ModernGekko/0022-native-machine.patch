+// Classic Controller (first-party extension) encryption tables, from Dolphin's
+// WiimoteEmu/Encryption.cpp (Hector Martin's reverse engineering).
+// Included by wiimote.cpp only.
+
+constexpr SBox fallback_sbox_1st_party_a = {
+    0x00, 0x3b, 0x4c, 0x89, 0x7b, 0xa5, 0x77, 0x17, 0xff, 0x9e, 0x9b, 0x9c, 0x4d, 0xa3, 0xe1, 0x0c,
