+#pragma once
+
+#include <cstdint>
+
+namespace moderngekko::ios
+{
+// Partition handle: the raw disc offset of a partition's header.
+constexpr uint64_t PARTITION_NONE = UINT64_MAX - 1;
+
+// The inserted disc as the drive reads it.
+class Disc
+{
+public:
+  virtual ~Disc() = default;
+
+  // Reads size bytes at offset: decrypted partition data, or raw disc bytes
+  // for PARTITION_NONE. False if any of them don't exist.
+  virtual bool Read(uint64_t offset, uint32_t size, uint8_t* out, uint64_t partition) const = 0;
+
+  // The partition the console boots the game from.
+  virtual uint64_t GamePartition() const = 0;
+  // Whether partitions carry hash blocks (0x7C00 data bytes per 0x8000 block).
+  virtual bool HasWiiHashes() const = 0;
+  // One past the last readable offset (the physical disc size).
+  virtual uint64_t EndOffset() const = 0;
+};
+}  // namespace moderngekko::ios
diff --git a/src/ios/ios.hpp b/src/ios/ios.hpp
new file mode 100644
index 0000000..b26c493
--- /dev/null
+++ b/src/ios/ios.hpp
@@ -0,0 +1,378 @@
+#pragma once
+
+// Native IOS: the Wii's Starlet-side services the game talks to over IPC
+// (/dev/di, /dev/fs and NAND files, /dev/stm, /dev/net/kd), as host code.
+// Independent of Dolphin; the host supplies guest memory, timed events and the
+// IPC reply path, so the same devices serve any chassis.
+
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <type_traits>
+#include <vector>
+
+namespace moderngekko::ios
+{
+// IOS return codes.
+enum : int32_t
+{
+  IPC_SUCCESS = 0,
+  IPC_EACCES = -1,
+  IPC_EEXIST = -2,
+  IPC_EINVAL = -4,
+  IPC_EMAX = -5,
+  IPC_ENOENT = -6,
+  IPC_EQUEUEFULL = -8,
+  IPC_EIO = -12,
+  IPC_ENOMEM = -22,
+  IPC_UNKNOWN = -9,
+};
+
+enum Command : uint32_t
+{
+  IPC_CMD_OPEN = 1,
+  IPC_CMD_CLOSE = 2,
+  IPC_CMD_READ = 3,
+  IPC_CMD_WRITE = 4,
+  IPC_CMD_SEEK = 5,
+  IPC_CMD_IOCTL = 6,
+  IPC_CMD_IOCTLV = 7,
+};
+
+// Timebase ticks (CPU clock / 12) in CPU ticks, the unit of every delay here.
+constexpr int64_t Tb(uint64_t timebase_ticks)
+{
+  return static_cast<int64_t>(timebase_ticks * 12);
+}
+// IOS's cost of a request without a better known time.
+constexpr int64_t DEFAULT_REPLY_DELAY = Tb(4000);
+constexpr int64_t IPC_OVERHEAD = Tb(2700);
+
+struct Host
+{
+  void* user = nullptr;
+  // MEM1 and MEM2, mapped for the devices' lifetime.
+  uint8_t* mem1 = nullptr;
+  uint32_t mem1_size = 0;
+  uint8_t* mem2 = nullptr;
+  uint32_t mem2_size = 0;
+  uint32_t ticks_per_second = 0;  // CPU clock
+  // Sends the reply of the request at `address` after delay CPU ticks.
+  void (*reply)(void* user, uint32_t address, int32_t value, int64_t delay) = nullptr;
+  // Calls Device::Event(event, data) of the device `device` after cycles CPU ticks.
+  void (*schedule)(void* user, int64_t cycles, uint32_t device, uint32_t event,
+                   uint32_t data) = nullptr;
+  uint64_t (*now)(void* user) = nullptr;  // CPU ticks
+};
+
+// Guest memory as IOS sees it: physical addresses (virtual ones are masked).
+class Memory
+{
+public:
+  explicit Memory(const Host& host) : m_host(host) {}
+
+  // Host pointer to size bytes at address, or null if they leave MEM1/MEM2.
+  uint8_t* Pointer(uint32_t address, uint32_t size) const
+  {
+    const uint32_t physical = address & 0x1FFFFFFF;
+    if (physical < m_host.mem1_size && size <= m_host.mem1_size - physical)
+      return m_host.mem1 + physical;
+    const uint32_t offset = physical - 0x10000000;
+    if (m_host.mem2 && offset < m_host.mem2_size && size <= m_host.mem2_size - offset)
+      return m_host.mem2 + offset;
+    return nullptr;
+  }
+
+  uint8_t Read8(uint32_t address) const
+  {
+    const uint8_t* p = Pointer(address, 1);
+    return p ? *p : 0;
+  }
+  uint16_t Read16(uint32_t address) const
+  {
+    const uint8_t* p = Pointer(address, 2);
+    return p ? static_cast<uint16_t>(p[0] << 8 | p[1]) : 0;
+  }
+  uint32_t Read32(uint32_t address) const
+  {
+    const uint8_t* p = Pointer(address, 4);
+    uint32_t v = 0;
+    if (p)
+      std::memcpy(&v, p, 4);
+    return __builtin_bswap32(v);
+  }
+  uint64_t Read64(uint32_t address) const
+  {
+    return static_cast<uint64_t>(Read32(address)) << 32 | Read32(address + 4);
+  }
+  void Write8(uint32_t address, uint8_t value) const
+  {
+    if (uint8_t* p = Pointer(address, 1))
+      *p = value;
+  }
+  void Write16(uint32_t address, uint16_t value) const
+  {
+    if (uint8_t* p = Pointer(address, 2))
+    {
+      p[0] = static_cast<uint8_t>(value >> 8);
+      p[1] = static_cast<uint8_t>(value);
+    }
+  }
+  void Write32(uint32_t address, uint32_t value) const
+  {
+    if (uint8_t* p = Pointer(address, 4))
+    {
+      value = __builtin_bswap32(value);
+      std::memcpy(p, &value, 4);
+    }
+  }
+  void Write64(uint32_t address, uint64_t value) const
+  {
+    Write32(address, static_cast<uint32_t>(value >> 32));
+    Write32(address + 4, static_cast<uint32_t>(value));
+  }
+  bool CopyTo(uint32_t address, const void* data, uint32_t size) const
+  {
+    uint8_t* p = Pointer(address, size);
+    if (!p)
+      return false;
+    std::memcpy(p, data, size);
+    return true;
+  }
+  bool CopyFrom(void* data, uint32_t address, uint32_t size) const
+  {
+    const uint8_t* p = Pointer(address, size);
+    if (!p)
+      return false;
+    std::memcpy(data, p, size);
+    return true;
+  }
+  void Fill(uint32_t address, uint8_t value, uint32_t size) const
+  {
+    if (uint8_t* p = Pointer(address, size))
+      std::memset(p, value, size);
+  }
+  // A NUL-terminated string of at most max_size bytes.
+  std::string ReadString(uint32_t address, uint32_t max_size) const
+  {
+    std::string s;
+    for (uint32_t i = 0; i < max_size; ++i)
+    {
+      const uint8_t* p = Pointer(address + i, 1);
+      if (!p || *p == 0)
+        break;
+      s.push_back(static_cast<char>(*p));
+    }
+    return s;
+  }
+
+private:
+  const Host& m_host;
+};
+
+// An IPC request block in guest memory (0x40 bytes; fields big-endian).
+struct Request
+{
+  uint32_t address = 0;
+  uint32_t command = 0;
+  int32_t fd = 0;
+
+  Request(const Memory& memory, uint32_t address_)
+      : address(address_), command(memory.Read32(address_)),
+        fd(static_cast<int32_t>(memory.Read32(address_ + 8)))
+  {
+  }
+};
+
+struct OpenRequest : Request
+{
+  std::string path;
+  uint32_t flags;
+  OpenRequest(const Memory& memory, uint32_t address_)
+      : Request(memory, address_), path(memory.ReadString(memory.Read32(address_ + 12), 64)),
+        flags(memory.Read32(address_ + 16))
+  {
+  }
+};
+
+struct ReadWriteRequest : Request
+{
+  uint32_t buffer;
+  uint32_t size;
+  ReadWriteRequest(const Memory& memory, uint32_t address_)
+      : Request(memory, address_), buffer(memory.Read32(address_ + 12)),
+        size(memory.Read32(address_ + 16))
+  {
+  }
+};
+
+struct SeekRequest : Request
+{
+  int32_t offset;
+  uint32_t mode;
+  SeekRequest(const Memory& memory, uint32_t address_)
+      : Request(memory, address_), offset(static_cast<int32_t>(memory.Read32(address_ + 12))),
+        mode(memory.Read32(address_ + 16))
+  {
+  }
+};
+
+struct IOCtlRequest : Request
+{
+  uint32_t request;
+  uint32_t buffer_in, buffer_in_size;
+  uint32_t buffer_out, buffer_out_size;
+  IOCtlRequest(const Memory& memory, uint32_t address_)
+      : Request(memory, address_), request(memory.Read32(address_ + 12)),
+        buffer_in(memory.Read32(address_ + 16)), buffer_in_size(memory.Read32(address_ + 20)),
+        buffer_out(memory.Read32(address_ + 24)), buffer_out_size(memory.Read32(address_ + 28))
+  {
+  }
+};
+
+struct IOCtlVRequest : Request
+{
+  struct Vector
+  {
+    uint32_t address;
+    uint32_t size;
+  };
+  uint32_t request;
+  std::vector<Vector> in;  // read by IOS
+  std::vector<Vector> io;  // written by IOS
+
+  IOCtlVRequest(const Memory& memory, uint32_t address_)
+      : Request(memory, address_), request(memory.Read32(address_ + 12))
+  {
+    const uint32_t in_count = memory.Read32(address_ + 16);
+    const uint32_t io_count = memory.Read32(address_ + 20);
+    const uint32_t vectors = memory.Read32(address_ + 24);
+    for (uint32_t i = 0; i < in_count + io_count && i < 64; ++i)
+    {
+      const Vector v{memory.Read32(vectors + i * 8), memory.Read32(vectors + i * 8 + 4)};
+      (i < in_count ? in : io).push_back(v);
+    }
+  }
+
+  bool HasVectors(size_t in_count, size_t io_count) const
+  {
+    if (in.size() != in_count || io.size() != io_count)
+      return false;
+    for (const Vector& v : in)
+      if (v.address == 0)
+        return false;
+    for (const Vector& v : io)
+      if (v.address == 0)
+        return false;
+    return true;
+  }
+};
+
+// Return value plus how long IOS takes to send it, in CPU ticks.
+struct Reply
+{
+  int32_t value;
+  int64_t delay = DEFAULT_REPLY_DELAY;
+};
+
+// Savestate stream in the encoding of Dolphin's PointerWrap (raw little-endian
+// PODs, bools as one byte, u32-counted strings and containers), so the native
+// devices read and write the same state as the Dolphin devices they replace.
+class StateIO
+{
+public:
+  StateIO(void* user, void (*bytes)(void*, void*, uint32_t), bool reading)
+      : m_user(user), m_bytes(bytes), m_reading(reading)
+  {
+  }
+  bool Reading() const { return m_reading; }
+
+  void Bytes(void* data, uint32_t size) { m_bytes(m_user, data, size); }
+  template <typename T>
+  void Do(T& value)
+  {
+    static_assert(std::is_trivially_copyable_v<T>);
+    Bytes(&value, sizeof(T));
+  }
+  void Do(bool& value)
+  {
+    uint8_t v = value;
+    Do(v);
+    value = v != 0;
+  }
+  void Do(std::string& value)
+  {
+    uint32_t size = static_cast<uint32_t>(value.size());
+    Do(size);
+    value.resize(size);
+    if (size)
+      Bytes(value.data(), size);
+  }
+  template <typename T>
+  void Do(std::optional<T>& value)
+  {
+    bool present = value.has_value();
+    Do(present);
+    if (m_reading)
+      value = present ? std::optional<T>(T{}) : std::nullopt;
+    if (present)
+      Do(*value);
+  }
+
+private:
+  void* m_user;
+  void (*m_bytes)(void*, void*, uint32_t);
+  bool m_reading;
+};
+
+class Device
+{
+public:
+  Device(const Host& host, std::string name) : m_host(host), m_memory(host), m_name(std::move(name))
+  {
+  }
+  virtual ~Device() = default;
+
+  const std::string& Name() const { return m_name; }
+
+  // Each returns the reply to send, or nullopt when the device replies later
+  // through Host::reply.
+  virtual std::optional<Reply> Open(const OpenRequest&)
+  {
+    m_active = true;
+    return Reply{IPC_SUCCESS};
+  }
+  virtual std::optional<Reply> Close(int32_t)
+  {
+    m_active = false;
+    return Reply{IPC_SUCCESS};
+  }
+  virtual std::optional<Reply> Read(const ReadWriteRequest&) { return Reply{IPC_EINVAL}; }
+  virtual std::optional<Reply> Write(const ReadWriteRequest&) { return Reply{IPC_EINVAL}; }
+  virtual std::optional<Reply> Seek(const SeekRequest&) { return Reply{IPC_EINVAL}; }
+  virtual std::optional<Reply> IOCtl(const IOCtlRequest&) { return Reply{IPC_EINVAL}; }
+  virtual std::optional<Reply> IOCtlV(const IOCtlVRequest&) { return Reply{IPC_EINVAL}; }
+  // A Host::schedule callback.
+  virtual void Event(uint32_t, uint32_t) {}
+
+  // Same layout as Dolphin's Device::DoState plus the device's own fields.
+  virtual void DoState(StateIO& io) { DoBaseState(io); }
+
+protected:
+  void DoBaseState(StateIO& io)
+  {
+    io.Do(m_name);
+    uint32_t type = 0;  // Dolphin's DeviceType::Static
+    io.Do(type);
+    io.Do(m_active);
+  }
+
+  const Host& m_host;
+  Memory m_memory;
+  std::string m_name;
+  bool m_active = false;
+};
+}  // namespace moderngekko::ios
diff --git a/src/ios/native_ios_host.cpp b/src/ios/native_ios_host.cpp
new file mode 100644
index 0000000..6646a1a
--- /dev/null
+++ b/src/ios/native_ios_host.cpp
@@ -0,0 +1,262 @@
+#include "native_ios_host.hpp"
+
+#include "Common/ChunkFile.h"
+#include "Core/Config/MainSettings.h"
+#include "Core/HW/DVD/DVDInterface.h"
+#include "Core/HW/DVD/DVDThread.h"
+#include "Core/HW/EXI/EXI_DeviceIPL.h"
+#include "Core/HW/Memmap.h"
+#include "Core/HW/SystemTimers.h"
+#include "Core/IOS/Device.h"
+#include "Core/IOS/ES/ES.h"
+#include "Core/IOS/ES/Formats.h"
+#include "Core/IOS/IOS.h"
+#include "Core/System.h"
+#include "DiscIO/Volume.h"
+
+#include "devices.hpp"
+
+#include <array>
+#include <cstdio>
+#include <string>
+#include <cstdlib>
+#include <string_view>
+
+namespace moderngekko::native_ios
+{
+namespace
+{
+// A native device's id is its index here: pending events carry it, so the
+// order is part of the savestate format.
+constexpr std::array<std::string_view, 5> DEVICES = {
+    "/dev/di", "/dev/stm/eventhook", "/dev/stm/immediate", "/dev/net/kd/request",
+    "/dev/net/kd/time",
+};
+constexpr uint32_t DI = 0;
+
+Core::System& SystemOf(void* user)
+{
+  return *static_cast<Core::System*>(user);
+}
+
+// The drive's disc: Dolphin's volume, read on the CPU thread.
+class DolphinDisc final : public ios::Disc
+{
+public:
+  explicit DolphinDisc(Core::System& system)
+      : m_system(system), m_game_partition(system.GetDVDThread().GetGamePartition().offset),
+        m_wii_hashes(system.GetDVDThread().HasWiiHashes()),
+        m_end_offset(system.GetDVDInterface().DiscEndOffset())
+  {
+  }
+
+  bool Read(uint64_t offset, uint32_t size, uint8_t* out, uint64_t partition) const override
+  {
+    return m_system.GetDVDThread().ReadDirect(offset, size, out, DiscIO::Partition(partition));
+  }
+  uint64_t GamePartition() const override { return m_game_partition; }
+  bool HasWiiHashes() const override { return m_wii_hashes; }
+  uint64_t EndOffset() const override { return m_end_offset; }
+
+private:
+  Core::System& m_system;
+  uint64_t m_game_partition;
+  bool m_wii_hashes;
+  uint64_t m_end_offset;
+};
+
+// Host and config outlive every kernel: a new kernel's devices are made
+// before the old kernel goes away.
+ios::Host s_host;
+ios::Config s_config;
+std::array<ios::Device*, DEVICES.size()> s_devices{};
+
+std::optional<IOS::HLE::IPCReply> ToDolphin(const std::optional<ios::Reply>& reply)
+{
+  if (!reply)
+    return std::nullopt;
+  return IOS::HLE::IPCReply(reply->value, static_cast<u64>(reply->delay));
+}
+
+// A native device in Dolphin's device interface.
+class Adapter final : public IOS::HLE::Device
+{
+public:
+  Adapter(IOS::HLE::Kernel& kernel, std::unique_ptr<ios::Device> native, uint32_t id)
+      : Device(kernel, native->Name()), m_native(std::move(native)), m_id(id), m_memory(s_host)
+  {
+    s_devices[m_id] = m_native.get();
+  }
+  ~Adapter() override
+  {
+    if (s_devices[m_id] == m_native.get())
+      s_devices[m_id] = nullptr;
+  }
+
+  std::optional<IOS::HLE::IPCReply> Open(const IOS::HLE::OpenRequest& request) override
+  {
+    return ToDolphin(m_native->Open(ios::OpenRequest(m_memory, request.address)));
+  }
+  std::optional<IOS::HLE::IPCReply> Close(u32 fd) override
+  {
+    return ToDolphin(m_native->Close(static_cast<int32_t>(fd)));
+  }
+  std::optional<IOS::HLE::IPCReply> Read(const IOS::HLE::ReadWriteRequest& request) override
+  {
+    return ToDolphin(m_native->Read(ios::ReadWriteRequest(m_memory, request.address)));
+  }
+  std::optional<IOS::HLE::IPCReply> Write(const IOS::HLE::ReadWriteRequest& request) override
+  {
+    return ToDolphin(m_native->Write(ios::ReadWriteRequest(m_memory, request.address)));
+  }
+  std::optional<IOS::HLE::IPCReply> Seek(const IOS::HLE::SeekRequest& request) override
+  {
+    return ToDolphin(m_native->Seek(ios::SeekRequest(m_memory, request.address)));
+  }
+  std::optional<IOS::HLE::IPCReply> IOCtl(const IOS::HLE::IOCtlRequest& request) override
+  {
+    return ToDolphin(m_native->IOCtl(ios::IOCtlRequest(m_memory, request.address)));
+  }
+  std::optional<IOS::HLE::IPCReply> IOCtlV(const IOS::HLE::IOCtlVRequest& request) override
+  {
+    return ToDolphin(m_native->IOCtlV(ios::IOCtlVRequest(m_memory, request.address)));
+  }
+
+  void DoState(PointerWrap& p) override
+  {
+    ios::StateIO io(
+        &p,
+        [](void* user, void* data, uint32_t size) {
+          static_cast<PointerWrap*>(user)->DoArray(static_cast<u8*>(data), size);
+        },
+        p.IsReadMode());
+    m_native->DoState(io);
+  }
+
+private:
+  std::unique_ptr<ios::Device> m_native;
+  uint32_t m_id;
+  ios::Memory m_memory;
+};
+
+void Reply(void* user, uint32_t address, int32_t value, int64_t delay)
+{
+  Core::System& system = SystemOf(user);
+  system.GetIOS()->EnqueueIPCReply(IOS::HLE::Request(system, address), value, delay);
+}
+
+void Schedule(void* user, int64_t cycles, uint32_t device, uint32_t event, uint32_t data)
+{
+  SystemOf(user).GetIOS()->ScheduleNativeEvent(
+      cycles, uint64_t{device} << 40 | uint64_t{event & 0xFF} << 32 | data);
+}
+
+uint64_t Now(void* user)
+{
+  return SystemOf(user).GetCoreTiming().GetTicks();
+}
+
+int64_t EmulatedTime(void* user)
+{
+  return ExpansionInterface::CEXIIPL::GetEmulatedTime(SystemOf(user),
+                                                      ExpansionInterface::CEXIIPL::UNIX_EPOCH);
+}
+
+int32_t OpenPartition(void* user, uint64_t partition, uint32_t tmd_address)
+{
+  Core::System& system = SystemOf(user);
+  auto& dvd_thread = system.GetDVDThread();
+  const DiscIO::Partition dolphin_partition(partition);
+  const IOS::ES::TMDReader tmd = dvd_thread.GetTMD(dolphin_partition);
+  const std::vector<u8>& raw_tmd = tmd.GetBytes();
+  system.GetMemory().CopyToEmu(tmd_address, raw_tmd.data(), raw_tmd.size());
+  return system.GetIOS()->GetESDevice()->DIVerify(tmd, dvd_thread.GetTicket(dolphin_partition));
+}
+
+void Create(IOS::HLE::EmulationKernel& kernel)
+{
+  Core::System& system = kernel.GetSystem();
+  auto& memory = system.GetMemory();
+  s_host = ios::Host{
+      .user = &system,
+      .mem1 = memory.GetRAM(),
+      .mem1_size = memory.GetRamSizeReal(),
+      .mem2 = memory.GetEXRAM(),
+      .mem2_size = memory.GetExRamSizeReal(),
+      .ticks_per_second = system.GetSystemTimers().GetTicksPerSecond(),
+      .reply = Reply,
+      .schedule = Schedule,
+      .now = Now,
+  };
+  // The native drive answers at buffer speed only; the drive model stays
+  // Dolphin's.
+  const bool native_di = system.GetDVDThread().HasDisc() &&
+                         Config::Get(Config::MAIN_FAST_DISC_SPEED);
+  if (native_di)
+    s_config.disc = std::make_shared<DolphinDisc>(system);
+  std::string names;
+  for (uint32_t id = 0; id < DEVICES.size(); ++id)
+  {
+    if ((id == DI && !native_di) || !kernel.GetDeviceByName(DEVICES[id]))
+      continue;
+    if (auto native = ios::CreateDevice(s_host, s_config, DEVICES[id], id))
+    {
+      kernel.AddNativeDevice(std::make_shared<Adapter>(kernel, std::move(native), id));
+      names.append(" ").append(DEVICES[id]);
+    }
+  }
+  if (!names.empty())
+    std::fprintf(stderr, "native IOS:%s\n", names.c_str());
+}
+
+void Event(IOS::HLE::EmulationKernel&, u64 userdata)
+{
+  const uint32_t id = static_cast<uint32_t>(userdata >> 40);
+  if (id < s_devices.size() && s_devices[id])
+    s_devices[id]->Event(static_cast<uint32_t>(userdata >> 32) & 0xFF, static_cast<uint32_t>(userdata));
+}
+
+bool DiInterrupt(IOS::HLE::EmulationKernel& kernel, bool success)
+{
+  if (!s_devices[DI] || !kernel.GetNativeDevice(DEVICES[DI]))
+    return false;
+  ios::FinishHostDiCommand(*s_devices[DI], success);
+  return true;
+}
+
+bool StmButton(IOS::HLE::EmulationKernel& kernel, bool power)
+{
+  if (!kernel.GetNativeDevice("/dev/stm/eventhook"))
+    return false;
+  power ? ios::PressPowerButton() : ios::PressResetButton();
+  return true;
+}
+
+constexpr IOS::HLE::NativeDevices HOOKS{
+    .create = Create,
+    .event = Event,
+    .di_interrupt = DiInterrupt,
+    .stm_button = StmButton,
+};
+}  // namespace
+
+void Install(Core::System&)
+{
+  // MODERNGEKKO_NATIVE_IOS=0 keeps Dolphin's devices, for A/B runs.
+  const char* v = std::getenv("MODERNGEKKO_NATIVE_IOS");
+  if (v && *v == '0')
+    return;
+  s_config = ios::Config{
+      .emulated_time = EmulatedTime,
+      .shutdown = nullptr,
+      .open_partition = OpenPartition,
+  };
+  IOS::HLE::SetNativeDevices(&HOOKS);
+}
+
+void Uninstall(Core::System&)
+{
+  IOS::HLE::SetNativeDevices(nullptr);
+  s_config.disc.reset();
+}
+}  // namespace moderngekko::native_ios
