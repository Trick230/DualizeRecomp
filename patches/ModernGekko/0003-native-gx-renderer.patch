diff --git a/src/gpu/native_gx_host.cpp b/src/gpu/native_gx_host.cpp
new file mode 100644
index 0000000..098cbe4
--- /dev/null
+++ b/src/gpu/native_gx_host.cpp
@@ -0,0 +1,114 @@
+#include "native_gx_host.hpp"
+
+#include "Core/HW/GPFifo.h"
+#include "Core/HW/Memmap.h"
+#include "Core/System.h"
+#include "VideoCommon/PixelEngine.h"
+
+#include "native_gx.h"
+
+#include <filesystem>
+#include <system_error>
+#include <utility>
+
+namespace moderngekko::native_gx
+{
+namespace
+{
+std::function<void()> s_on_quit;
+
+constexpr u32 PHYSICAL_MASK = 0x1FFFFFFF;
+constexpr u32 EXRAM_BASE = 0x10000000;
+
+// Cached and uncached virtual mirrors both map onto physical MEM1/MEM2.
+bool Resolve(void* user, uint32_t address, uint32_t size, const void** data, uint32_t* available)
+{
+  auto& memory = static_cast<Core::System*>(user)->GetMemory();
+  const u32 physical = address & PHYSICAL_MASK;
+  u8* base;
+  u32 offset;
+  u32 limit;
+  if (physical < memory.GetRamSizeReal())
+  {
+    base = memory.GetRAM();
+    offset = physical;
+    limit = memory.GetRamSizeReal();
+  }
+  else if (physical >= EXRAM_BASE && memory.GetEXRAM() &&
+           physical - EXRAM_BASE < memory.GetExRamSizeReal())
+  {
+    base = memory.GetEXRAM();
+    offset = physical - EXRAM_BASE;
+    limit = memory.GetExRamSizeReal();
+  }
+  else
+  {
+    return false;
+  }
+  if (size > limit - offset)
+    return false;
+  *data = base + offset;
+  *available = limit - offset;
+  return true;
+}
+
+// The render thread reaching a marker is the GPU reaching it; in dual-core
+// mode PixelEngine schedules the interrupt from any thread, as it does for
+// Dolphin's own GPU thread.
+void DrawDone(void* user)
+{
+  static_cast<Core::System*>(user)->GetPixelEngine().SetFinish(0);
+}
+
+void Token(void* user, uint16_t token, bool interrupt)
+{
+  static_cast<Core::System*>(user)->GetPixelEngine().SetToken(token, interrupt, 0);
+}
+
+void Quit(void*)
+{
+  if (s_on_quit)
+    s_on_quit();
+}
+
+void SubmitBursts(const u8* data, size_t size, void*)
+{
+  native_gx_submit(data, size);
+}
+}  // namespace
+
+bool Start(Core::System& system, const std::string& title, const std::string& cache_path,
+           std::function<void()> on_quit)
+{
+  s_on_quit = std::move(on_quit);
+  std::error_code error;
+  std::filesystem::create_directories(cache_path, error);
+  if (error)
+    return false;
+  const NativeGxConfig config{
+      .title = title.c_str(),
+      .cache_path = cache_path.c_str(),
+      .width = 1280,
+      .height = 960,
+      .vsync = true,
+  };
+  const NativeGxHost host{
+      .user = &system,
+      .resolve = Resolve,
+      .draw_done = DrawDone,
+      .token = Token,
+      .quit = Quit,
+  };
+  if (!native_gx_start(&config, &host))
+    return false;
+  system.GetGPFifo().SetBurstSink(SubmitBursts, nullptr);
+  return true;
+}
+
+void Stop(Core::System& system)
+{
+  system.GetGPFifo().SetBurstSink(nullptr, nullptr);
+  native_gx_stop();
+  s_on_quit = nullptr;
+}
+}  // namespace moderngekko::native_gx
