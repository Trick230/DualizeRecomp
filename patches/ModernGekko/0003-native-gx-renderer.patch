+++ b/src/gpu/native_gx_host.hpp
@@ -0,0 +1,20 @@
+#pragma once
+
+#include <functional>
+#include <string>
+
+namespace Core
+{
+class System;
+}
+
+namespace moderngekko::native_gx
+{
+// Renders the guest's GX FIFO natively (Aurora, own window and render thread)
+// instead of through Dolphin's video emulation, which must be the Null
+// backend in dual-core mode. Call before boot; on_quit runs on the render
+// thread when the user closes the window.
+bool Start(Core::System& system, const std::string& title, const std::string& cache_path,
+           std::function<void()> on_quit);
+void Stop(Core::System& system);
+}  // namespace moderngekko::native_gx
