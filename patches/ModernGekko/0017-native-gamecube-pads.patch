+    gc.c_x = Merge(gc.c_x, overlay.gc.c_x);
+    gc.c_y = Merge(gc.c_y, overlay.gc.c_y);
+    gc.left_trigger = std::max(gc.left_trigger, overlay.gc.left_trigger);
+    gc.right_trigger = std::max(gc.right_trigger, overlay.gc.right_trigger);
+  }
