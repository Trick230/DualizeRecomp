+// The local PPC_FLAT_BASE names in chunk files (see emit_chunk_file): a copy
+// of ctx->flat_base no store can alias, so the compiler keeps it in a
+// register instead of reloading it around every access.
+static void emit_flat_base(FILE* out) {
+    fprintf(out, "    u8* const dolrecomp_base = ctx->flat_base;\n");
+    fprintf(out, "    (void)dolrecomp_base;\n");
+}
