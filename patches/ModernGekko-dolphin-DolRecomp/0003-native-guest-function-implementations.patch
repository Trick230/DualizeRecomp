index 4835338..848b2c2 100644
--- a/src/backend/emitter.c
+++ b/src/backend/emitter.c
@@ -323,6 +323,26 @@ void emit_set_chunk_table(const u32* starts, u32 count) {
     g_chunk_count = count ? count : 0;
 }
 
+static const DolRecompNative* g_natives = NULL;
+static u32 g_native_count = 0;
+
+void emit_set_natives(const DolRecompNative* natives, u32 count) {
+    g_natives = count ? natives : NULL;
+    g_native_count = count ? count : 0;
+}
+
+static const char* native_for(u32 addr) {
+    u32 lo = 0, hi = g_native_count;
+    while (lo < hi) {
+        u32 mid = lo + (hi - lo) / 2u;
+        if (g_natives[mid].address < addr)
+            lo = mid + 1u;
+        else
+            hi = mid;
+    }
+    return lo < g_native_count && g_natives[lo].address == addr ? g_natives[lo].name : NULL;
+}
+
 // The index of the chunk whose func_<start>() covers `addr`, or -1 if none
 // does. Chunks tile the text sections but the first one does not start on the
 // common stride, so this binary-searches rather than dividing.
@@ -392,6 +412,19 @@ static void emit_direct_branch(FILE* out, const PPCInst* inst,
 
     if (inst->lk) {
         fprintf(out, "            ctx->lr = 0x%08Xu;\n", inst->address + 4);
+        // A native callee resumes straight after the call, skipping both the
+        // guest body and the return dispatch; if it declines, a local callee
+        // is entered past its own (already tried) native check.
+        const char* native = native_for(inst->branch_target);
+        if (native && branch_target_is_local(func_start, func_end, inst->address + 4u)) {
+            fprintf(out, "            {\n");
+            fprintf(out, "                bool %s(CPUState* ctx);\n", native);
+            fprintf(out, "                if (%s(ctx))\n", native);
+            fprintf(out, "                    goto label_%08X;\n", inst->address + 4u);
+            fprintf(out, "            }\n");
+        } else {
+            native = NULL;
+        }
         if (local_target) {
             if (local_backward) {
                 fprintf(out, "            if (ctx->downcount <= -(s64)DOLRECOMP_C_LOOP_CYCLE_BUDGET) {\n");
@@ -399,7 +432,8 @@ static void emit_direct_branch(FILE* out, const PPCInst* inst,
                 fprintf(out, "                return;\n");
                 fprintf(out, "            }\n");
             }
-            fprintf(out, "            goto label_%08X;\n", inst->branch_target);
+            fprintf(out, "            goto %s_%08X;\n", native ? "native_declined" : "label",
+                    inst->branch_target);
         } else if (!emit_cross_chunk_call(out, inst, func_start, func_end)) {
             fprintf(out, "            ctx->pc = 0x%08Xu;\n", inst->branch_target);
             fprintf(out, "            return;\n");
@@ -2007,6 +2041,20 @@ bool emit_function(FILE* out, const PPCInst* insts, u32 count, u32 func_addr) {
 
     for (u32 i = 0; i < count; i++) {
         fprintf(out, "label_%08X:\n", insts[i].address);
+        // Entry check for callers that did not try the native themselves:
+        // tail calls, indirect calls and chassis dispatch.
+        const char* native = native_for(insts[i].address);
+        if (native) {
+            fprintf(out, "    {\n");
+            fprintf(out, "        bool %s(CPUState* ctx);\n", native);
+            fprintf(out, "        if (%s(ctx)) {\n", native);
+            fprintf(out, "            ctx->pc = ctx->lr & ~3u;\n");
+            fprintf(out, has_local_returns ? "            goto return_dispatch_%08X;\n"
+                                           : "            return;\n", func_addr);
+            fprintf(out, "        }\n");
+            fprintf(out, "    }\n");
+            fprintf(out, "native_declined_%08X: __attribute__((unused));\n", insts[i].address);
+        }
         if (cfg.loop_ends[i] != UINT32_MAX) {
             u32 continuation = insts[cfg.loop_ends[i]].address + 4u;
             fprintf(out, "    loop_%08X(ctx);\n", insts[i].address);
diff --git a/src/backend/emitter.h b/src/backend/emitter.h
index 39d8f3c..e4aae86 100644
--- a/src/backend/emitter.h
+++ b/src/backend/emitter.h
@@ -23,6 +23,16 @@ void emit_header_for_cpu(FILE* out, DolRecompCPU cpu);
 // passing count == 0 restores the safe return-to-chassis form.
 void emit_set_chunk_table(const u32* starts, u32 count);
 
+// A guest function with a host implementation, `bool name(CPUState*)`, that
+// the module links in. It returns true after doing the whole call (registers,
+// memory, cycles) and false, with no side effects, when the guest code has to
+// run instead. Same lifetime rules as the chunk table; sorted by address.
+typedef struct {
+    u32 address;
+    const char* name;
+} DolRecompNative;
+void emit_set_natives(const DolRecompNative* natives, u32 count);
+
 // emit a single recompiled function as C code
 bool emit_function(FILE* out, const PPCInst* insts, u32 count, u32 func_addr);
 
diff --git a/tests/test_natives.c b/tests/test_natives.c
new file mode 100644
index 0000000..ad716fd
--- /dev/null
+++ b/tests/test_natives.c
@@ -0,0 +1,95 @@
+#include "app/natives.h"
+#include "backend/emitter.h"
+#include "frontend/decoder.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "check failed: %s:%d: %s\n", \
+    __FILE__, __LINE__, #x); return 1; } } while (0)
+
+static int write_text(const char* path, const char* text) {
+    FILE* file = fopen(path, "w");
+    if (!file)
+        return 0;
+    fputs(text, file);
+    return fclose(file) == 0;
+}
+
+static char* read_text(const char* path) {
+    FILE* file = fopen(path, "rb");
+    if (!file)
+        return NULL;
+    fseek(file, 0, SEEK_END);
+    long size = ftell(file);
+    fseek(file, 0, SEEK_SET);
+    char* text = malloc((size_t)size + 1);
+    if (text && fread(text, 1, (size_t)size, file) != (size_t)size) {
+        free(text);
+        text = NULL;
+    }
+    if (text)
+        text[size] = '\0';
+    fclose(file);
+    return text;
+}
+
+int main(void) {
+    // blr; li r3,0. FNV-1a 64 of the first four bytes is B6F2E0C4BC8017BB.
+    static const u8 code[] = {0x4E, 0x80, 0x00, 0x20, 0x38, 0x60, 0x00, 0x00};
+    LoadedCodeSection section = {0};
+    section.data = code;
+    section.address = 0x80001000u;
+    section.size = sizeof(code);
+
+    const char* path = "test_natives.list";
+    DolRecompNativeList list;
+
+    CHECK(write_text(path, "# comment\n"
+                           "80001000 4 B6F2E0C4BC8017BB host_leaf\n"
+                           "80001004 4 0 host_other  # trailing comment\n"));
+    CHECK(natives_load(&list, path));
+    CHECK(list.count == 2);
+    CHECK(list.entries[0].address == 0x80001000u);
+    CHECK(strcmp(list.entries[1].name, "host_other") == 0);
+    CHECK(!natives_verify(&list, &section, 1));  // second hash is wrong
+    natives_free(&list);
+    CHECK(write_text(path, "80001000 4 B6F2E0C4BC8017BB host_leaf\n"));
+    CHECK(natives_load(&list, path));
+    CHECK(natives_verify(&list, &section, 1));
+    natives_free(&list);
+
+    CHECK(write_text(path, "80001004 4 0 b\n80001000 4 0 a\n"));
+    CHECK(!natives_load(&list, path));  // unsorted
+    CHECK(write_text(path, "80001000 4 0 not-a-symbol\n"));
+    CHECK(!natives_load(&list, path));
+    CHECK(write_text(path, "80002000 4 0 outside\n"));
+    CHECK(natives_load(&list, path));
+    CHECK(!natives_verify(&list, &section, 1));
+    natives_free(&list);
+
+    // A bl to a native resumes after the call when the native accepts, and a
+    // native function entry checks it before running its guest body.
+    static const DolRecompNative natives[] = {{0x80001008u, "host_leaf"}};
+    PPCInst insts[3];
+    const u32 words[3] = {0x48000009u /* bl +8 */, 0x60000000u, 0x4E800020u};
+    for (u32 i = 0; i < 3; ++i)
+        insts[i] = ppc_decode(words[i], 0x80001000u + i * 4u);
+    const char* out_path = "test_natives.c.out";
+    FILE* out = fopen(out_path, "wb");
+    CHECK(out);
+    emit_set_natives(natives, 1);
+    CHECK(emit_function(out, insts, 3, 0x80001000u));
+    emit_set_natives(NULL, 0);
+    fclose(out);
+    char* text = read_text(out_path);
+    CHECK(text);
+    CHECK(strstr(text, "if (host_leaf(ctx))\n                    goto label_80001004;"));
+    CHECK(strstr(text, "goto native_declined_80001008;"));
+    CHECK(strstr(text, "label_80001008:\n    {\n        bool host_leaf(CPUState* ctx);"));
+    free(text);
+    remove(out_path);
+    remove(path);
+    return 0;
+}
