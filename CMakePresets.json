{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "base",
      "displayName": "Release with debug info",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "pgo-generate",
      "inherits": "release",
      "displayName": "Release, instrumented for PGO (scripts/pgo.sh)",
      "cacheVariables": { "DUALIZE_PGO": "GENERATE" }
    },
    {
      "name": "pgo",
      "inherits": "release",
      "displayName": "Release optimised with the PGO profile (scripts/pgo.sh)",
      "cacheVariables": { "DUALIZE_PGO": "USE" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "pgo-generate", "configurePreset": "pgo-generate" },
    { "name": "pgo", "configurePreset": "pgo" }
  ]
}
